@model List<KHQ.Domain.ViewModel.WhyChooseUsVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item">Home page / </li>
                            <li class="breadcrumb-item active">Why choose us section</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Why choose us section</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-xl-4">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="WhyChooseId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="row align-items-center">
                                    <div class="col d-flex gap-2">
                                        <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.TitleEn</h5>/ <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.TitleAr</h5>
                                    </div>
                                    <div class="col d-flex gap-2">
                                        <h3 class="m-0">@Html.Raw(item.Icon)</h3>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div> <!-- end card-->
                </div>

                <!-- Edit Modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="WhyChooseFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="TitleEn-edit-@item.Id" class="form-label">Point in English:</label>
                                        <input class="form-control" type="text" id="TitleEn-edit-@item.Id"
                                               required="" placeholder="Enter point in english" value="@item.TitleEn">
                                        <span class="validationTitleEn text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="TitleAr-edit-@item.Id" class="form-label">Point in Arabic:</label>
                                        <input class="form-control" type="text" id="TitleAr-edit-@item.Id"
                                               required="" placeholder="Enter point in arabic" value="@item.TitleAr">
                                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="desc-edit-@item.Id" class="form-label">Description in english:</label>
                                        <textarea class="form-control" type="text" id="desc-edit-@item.Id"
                                              required="" placeholder="Enter name of title">@item.DescriptionEn</textarea>
                                        <span class="validationDesc text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="descAr-edit-@item.Id" class="form-label">Description in arabic:</label>
                                        <textarea class="form-control" type="text" id="descAr-edit-@item.Id"
                                              required="" placeholder="Enter name of title">@item.DescriptionAr</textarea>
                                        <span class="validationDescAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Icon-edit-@item.Id" class="form-label">Icon:</label>
                                        <input class="form-control" type="text" id="Icon-edit-@item.Id"
                                               required="" placeholder="Enter icon" value="@item.Icon">
                                        <span class="validationIcon text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditWhyChooseSectionsbtn-@item.Id"
                                                type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete?</p>
                                    <button type="button"
                                            data-id="@item.Id"
                                            class="btn btn-light my-2 deleteWhyChoose"
                                            data-bs-dismiss="modal">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="WhyChooseForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="TitleEn" class="form-label">Title in English:</label>
                        <input class="form-control" type="text" id="TitleEn"
                               required="" placeholder="Enter title in english">
                        <span class="validationTitleEn text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="TitleAr" class="form-label">Title in Arabic:</label>
                        <input class="form-control" type="text" id="TitleAr"
                               required="" placeholder="Enter title in arabic">
                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="desc" class="form-label">Description in english:</label>
                        <textarea class="form-control" type="text" id="desc"
                                  required="" placeholder="Enter description in english"></textarea>
                        <span class="validationDesc text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="descAr" class="form-label">Description in arabic:</label>
                        <textarea class="form-control" type="text" id="descAr"
                                  required="" placeholder="Enter description in arabic"></textarea>
                        <span class="validationDescAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="Icon" class="form-label">Icon:</label>
                        <input class="form-control" type="text" id="Icon"
                               required="" placeholder="Enter icon">
                        <span class="validationIcon text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveWhyChooseSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveWhyChooseSectionsbtn').click(function () {
            var validation = true;
            var titleEnValue = $('#TitleEn').val();
            var titleArValue = $('#TitleAr').val();
            var descValue = $('#desc').val();
            var descArValue = $('#descAr').val();
            var iconValue = $('#Icon').val();

            // Validation logic
            if (titleEnValue == "") {
                $(".validationTitleEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleEn").addClass("display-none");
            }
            if (titleArValue == "") {
                $(".validationTitleAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleAr").addClass("display-none");
            }
            if (iconValue == "") {
                $(".validationIcon").removeClass("display-none");
                validation = false;
            } else {
                $(".validationIcon").addClass("display-none");
            }
            if (descValue == "") {
                $(".validationDesc").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDesc").addClass("display-none");
            }
            if (descArValue == "") {
                $(".validationDescAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDescAr").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("TitleEn", titleEnValue);
                formData.append("TitleAr", titleArValue);
                formData.append("DescriptionEn", descValue);
                formData.append("DescriptionAr", descArValue);
                formData.append("Icon", iconValue);

                $.ajax({
                    url: '@Url.Action("Add", "WhyChooseUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
        });

        $(document).on("click", ".deleteWhyChoose", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "WhyChooseUs")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
            var validation = true;
            var titleEnValue = $('#TitleEn-edit-' + itemId).val();
            var titleArValue = $('#TitleAr-edit-' + itemId).val();
            var descValue = $('#desc-edit-' + itemId).val();
            var descArValue = $('#descAr-edit-' + itemId).val();
            var iconValue = $('#Icon-edit-' + itemId).val();

            // Validation logic
            if (titleEnValue == "") {
                $(".validationTitleEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleEn").addClass("display-none");
            }
            if (titleArValue == "") {
                $(".validationTitleAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleAr").addClass("display-none");
            }
            if (iconValue == "") {
                $(".validationIcon").removeClass("display-none");
                validation = false;
            } else {
                $(".validationIcon").addClass("display-none");
            }
            if (descValue == "") {
                $(".validationDesc").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDesc").addClass("display-none");
            }
            if (descArValue == "") {
                $(".validationDescAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDescAr").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("TitleEn", titleEnValue);
                formData.append("TitleAr", titleArValue);
                formData.append('DescriptionEn', descValue);
                formData.append('DescriptionAr', descArValue);
                formData.append("Icon", iconValue);
                formData.append('id', itemId);

                $.ajax({
                    url: '@Url.Action("Update", "WhyChooseUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success-edit").removeClass("display-none");
                        $(".alert-success-edit").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
    }
</script>