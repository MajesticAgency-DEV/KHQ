@model List<KHQ.Domain.ViewModel.ProductVM>

<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">Dashboards / </li>
                            <li class="breadcrumb-item">Products page / </li>
                            <li class="breadcrumb-item active">Products section</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Products page > Products section</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-between">
                            <div class="col-auto">
                            <form method="get" class="d-flex flex-wrap align-items-center">
                                <div class="me-3">
                                    <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search...">
                                </div>
                                <label for="status-select" class="me-2">Sort By</label>
                                <div class="me-sm-3">
                                @Html.DropDownList(
                                    "sortBy",
                                    new List<SelectListItem>
                                    {
                                        new SelectListItem { Value = "", Text = "All", Selected = string.IsNullOrEmpty(ViewBag.SortBy) },
                                        new SelectListItem { Value = "AToZ", Text = "A To Z", Selected = (ViewBag.SortBy == "AToZ") },
                                        new SelectListItem { Value = "ZToA", Text = "Z To A", Selected = (ViewBag.SortBy == "ZToA") },
                                        new SelectListItem { Value = "PriceLow", Text = "Price Low", Selected = (ViewBag.SortBy == "PriceLow") },
                                        new SelectListItem { Value = "PriceHigh", Text = "Price High", Selected = (ViewBag.SortBy == "PriceHigh") },
                                    },
                                    new { @class = "form-select", onchange = "this.form.submit()" }
                                )
                                </div>
                                <button type="submit" class="btn btn-primary all-btn">Search</button>
                            </form>
                            </div>
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <a href="/Product/Create" class="btn btn-danger waves-effect waves-light"><i class="fa-regular fa-circle-plus"></i> Add New</a>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card product-box">
                    <div class="card-body">
                        <div class="product-action">
                                 <button class="btn btn-xs waves-effect waves-light mt-2 mt-md-0" type="button"
                                    data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight-@item.Id"
                                    aria-controls="offcanvasRight" style="background:#ccc">
                                    <i class="fa-light fa-eye text-white"></i>
                                 </button>
                            <a href="/Product/Update/@item.Id" class="btn btn-success btn-xs waves-effect waves-light">
                                <i class="fa-sharp fa-light fa-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                <i class="fa-sharp fa-light fa-trash"></i>
                            </button>
                        </div>
                            @if (item.PathLink.Count > 0)
                            {
                            <div class="bg-light">
                                <img src="@item.PathLink[0]" alt="product-pic" class="img-fluid">
                            </div>
                            }
                        <div class="product-info">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="font-16 mt-0 sp-line-1"><a href="ecommerce-product-detail.html" class="text-dark">@item.NameEn - @item.NameAr</a> </h5>
                                </div>
                                <div class="col-auto">
                                    <div class="product-price-tag">
                                        @item.Capacity
                                    </div>
                                </div>
                            </div> <!-- end row -->
                        </div> <!-- end product info-->

                        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight-@item.Id" aria-labelledby="offcanvasRightLabel">
                            <div class="offcanvas-header">
                                <h3 id="offcanvasRightLabel">Name in English: @item.NameEn</h3>
                                <h3 id="offcanvasRightLabel">Name in Arabic: @item.NameAr</h3>
                                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                            </div>

                            <div class="offcanvas-body">
                                <h5 class="mt-3">Description in English: @item.DescriptionEn</h5>
                                <hr />
                                <h5 class="mt-3">Description in Arabic: @item.DescriptionAr</h5>
                                <hr />
                                <h5 class="mt-3">Price: @item.Capacity</h5>
                                <hr />
                                <div class="row row-gap-3">
                                    <div class="col-12">
                                        @foreach (var img in item.PathLink)
                                            {
                                            <img src="@img" style="width: 100%;" />
                                            <hr />
                                            }
                                    </div>
                                </div>
                            </div>
                        </div>
                
                        <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-sm">
                                <div class="modal-content modal-filled bg-danger">
                                    <div class="modal-body p-4">
                                        <div class="text-center">
                                            <i class="fa-regular fa-ban text-white font-36"></i>
                                            <h4 class="mt-2 text-white">Oh snap!</h4>
                                            <p class="mt-3 text-white">Are you sure you want to delete ?</p>
                                            <button type="button"
                                                data-id="@item.Id"
                                                class="btn btn-light my-2 deleteProduct"
                                                data-bs-dismiss="modal">Continue</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- end card-->
            </div> <!-- end col-->
            }
            
        </div>
        <!-- end row-->

        <!-- end row-->

    </div> <!-- container -->

</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

                    <script>
                            // Delete functionality
    $(document).on("click", ".deleteProduct", function () {
        var id = $(this).data('id');
        var formData = new FormData();
        formData.append('id', id);

        $.ajax({
            url: '@Url.Action("Delete", "Product")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function () {
                location.reload();
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    });
                    </script>