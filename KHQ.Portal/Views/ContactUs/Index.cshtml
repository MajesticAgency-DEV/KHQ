@model List<KHQ.Domain.ViewModel.ContactUsVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item active">Contact us sections</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Contact us sections</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        @if(Model.Count == 0 || Model == null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-end">
                                <div class="col-auto">
                                    <div class="text-lg-end my-1 my-lg-0">
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                                data-bs-target="#add-modal">
                                            <i class="fa-regular fa-circle-plus"></i> Add New
                                        </button>
                                    </div>
                                </div><!-- end col-->
                            </div> <!-- end row -->
                        </div>
                    </div> <!-- end card -->
                </div> <!-- end col-->
            </div>
            <!-- end row-->
        }

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-xl-12">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="ContactUsId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="col-xl-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <div id="cardCollpase5" class="collapse show">
                                                <div class="table-responsive pt-3">
                                                    <table class="table table-hover table-centered mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>Email</th>
                                                                <th>Phone number</th>
                                                                <th>Fax</th>
                                                                <th>Company location</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>@item.Email</td>
                                                                <td>@item.PhoneNumber</td>
                                                                <td>@item.Fax</td>
                                                                <td>@item.CompanyLocation</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div> <!-- end table responsive-->
                                            </div> <!-- collapsed end -->
                                        </div> <!-- end card-body -->
                                    </div> <!-- end card-->
                                </div>
                            </div>

                        </div>
                    </div> <!-- end card-->
                </div>

                <!-- Edit Modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="ContactUsFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="Email-edit-@item.Id" class="form-label">Email:</label>
                                        <input class="form-control" type="text" id="Email-edit-@item.Id"
                                               required="" placeholder="Enter email" value="@item.Email">
                                        <span class="validationEmail text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="PhoneNumber-edit-@item.Id" class="form-label">Phone Number:</label>
                                        <input class="form-control" type="text" id="PhoneNumber-edit-@item.Id"
                                               required="" placeholder="Enter phone number" value="@item.PhoneNumber">
                                        <span class="validationPhoneNumber text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Fax-edit-@item.Id" class="form-label">Fax:</label>
                                        <input class="form-control" type="text" id="Fax-edit-@item.Id"
                                               required="" placeholder="Enter Fax" value="@item.Fax">
                                        <span class="validationFax text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="CompanyLocation-edit-@item.Id" class="form-label">Company Location:</label>
                                        <input class="form-control" type="text" id="CompanyLocation-edit-@item.Id"
                                               required="" placeholder="Enter company location" value="@item.CompanyLocation">
                                        <span class="validationCompanyLocation text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditContactUsSectionsbtn-@item.Id"
                                                type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete?</p>
                                    <button type="button"
                                            data-id="@item.Id"
                                            class="btn btn-light my-2 deleteContactUs"
                                            data-bs-dismiss="modal">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="ContactUsForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="Email" class="form-label">Email:</label>
                        <input class="form-control" type="text" id="Email"
                               required="" placeholder="Enter email">
                        <span class="validationEmail text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="PhoneNumber" class="form-label">Phone Number:</label>
                        <input class="form-control" type="text" id="PhoneNumber"
                               required="" placeholder="Enter phone number">
                        <span class="validationPhoneNumber text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="Fax" class="form-label">Fax:</label>
                        <input class="form-control" type="text" id="Fax"
                               required="" placeholder="Enter Fax">
                        <span class="validationFax text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="CompanyLocation" class="form-label">Company Location:</label>
                        <input class="form-control" type="text" id="CompanyLocation"
                               required="" placeholder="Enter company location">
                        <span class="validationCompanyLocation text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveContactUsSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveContactUsSectionsbtn').click(function () {
            var validation = true;
            var emailValue = $('#Email').val();
            var phoneNumberValue = $('#PhoneNumber').val();
            var faxValue = $('#Fax').val();
            var companyLocationValue = $('#CompanyLocation').val();

            // Validation logic
            if (emailValue == "") {
                $(".validationEmail").removeClass("display-none");
                validation = false;
            } else {
                $(".validationEmail").addClass("display-none");
            }
            if (phoneNumberValue == "") {
                $(".validationPhoneNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPhoneNumber").addClass("display-none");
            }
            if (faxValue == "") {
                $(".validationFax").removeClass("display-none");
                validation = false;
            } else {
                $(".validationFax").addClass("display-none");
            }
            if (companyLocationValue == "") {
                $(".validationCompanyLocation").removeClass("display-none");
                validation = false;
            } else {
                $(".validationCompanyLocation").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("Email", emailValue);
                formData.append("PhoneNumber", phoneNumberValue);
                formData.append("Fax", faxValue);
                formData.append("CompanyLocation", companyLocationValue);

                $.ajax({
                    url: '@Url.Action("Add", "ContactUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
        });

        $(document).on("click", ".deleteContactUs", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "ContactUs")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
            var validation = true;
            var emailValue = $('#Email-edit-' + itemId).val();
            var phoneNumberValue = $('#PhoneNumber-edit-' + itemId).val();
            var faxValue = $('#Fax-edit-' + itemId).val();
            var companyLocationValue = $('#CompanyLocation-edit-' + itemId).val();

            // Validation logic
            if (emailValue == "") {
                $(".validationEmail").removeClass("display-none");
                validation = false;
            } else {
                $(".validationEmail").addClass("display-none");
            }
            if (phoneNumberValue == "") {
                $(".validationPhoneNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPhoneNumber").addClass("display-none");
            }
            if (faxValue == "") {
                $(".validationFax").removeClass("display-none");
                validation = false;
            } else {
                $(".validationFax").addClass("display-none");
            }
            if (companyLocationValue == "") {
                $(".validationCompanyLocation").removeClass("display-none");
                validation = false;
            } else {
                $(".validationCompanyLocation").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("Email", emailValue);
                formData.append("PhoneNumber", phoneNumberValue);
                formData.append("Fax", faxValue);
                formData.append("CompanyLocation", companyLocationValue);
                formData.append('id', itemId);

                $.ajax({
                    url: '@Url.Action("Update", "ContactUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success-edit").removeClass("display-none");
                        $(".alert-success-edit").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
    }

    function uploadImage(event, itemId) {
        try {
            const imagePreview = $("#imagePreview-edit-" + itemId);

            // Store file specifically for this item
            editModalFiles[itemId] = event.target.files[0] || null;

            // Clear previous preview
            imagePreview.empty();

            if (editModalFiles[itemId]) {
                // Create a container for the image with a delete button
                const imageContainer = $("<div>")
                    .addClass("image-container col-4")
                    .css({
                        "position": "relative",
                        "margin-bottom": "8px"
                    });

                // Create an image element for the selected image
                const img = $("<img>")
                    .attr("src", URL.createObjectURL(editModalFiles[itemId]))
                    .addClass("img-thumbnail")
                    .css("max-width", "150px")
                    .on('error', function() {
                        console.error('Failed to load image preview');
                        imageContainer.remove();
                    });

                // Create a delete button for the image
                const deleteButton = $("<button>")
                    .attr("type", "button")
                    .addClass("btn btn-danger btn-sm")
                    .css({
                        "position": "absolute",
                        "bottom": "0",
                        "right": "0"
                    })
                    .html('<i class="fa-light fa-trash"></i>')
                    .on("click", function () {
                        // Clear the selected file for this specific item
                        delete editModalFiles[itemId];
                        imageContainer.remove();
                        $("#imageInput-edit-" + itemId).val(''); // Clear the file input
                    });

                // Append the image and delete button to the container
                imageContainer.append(img, deleteButton);

                // Append the container to the image preview div
                imagePreview.append(imageContainer);
            }
        } catch (error) {
            console.error('Error in uploadImage function:', error);
            alert('Error uploading image. Please try again.');
        }
    }
</script>