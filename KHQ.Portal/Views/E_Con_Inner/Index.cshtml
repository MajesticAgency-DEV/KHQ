@model List<KHQ.Domain.ViewModel.E_Con_InnerVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item">Home page / </li>
                            <li class="breadcrumb-item active">Statistics sections</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Home page > Statistics sections</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-xl-4">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="E_Con_InnerId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="row align-items-center">
                                    <div class="col d-flex gap-2">
                                        <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.NameEn</h5>/ <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.NameAr</h5>
                                    </div>
                                    <div class="col d-flex gap-2">
                                        <h3 class="m-0">@item.Number</h3>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div> <!-- end card-->
                </div>

                <!-- Edit Modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="E_Con_InnerFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="NameEn-edit-@item.Id" class="form-label">Name in English:</label>
                                        <input class="form-control" type="text" id="NameEn-edit-@item.Id"
                                               required="" placeholder="Enter name in english" value="@item.NameEn">
                                        <span class="validationNameEn text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="NameAr-edit-@item.Id" class="form-label">Name in Arabic:</label>
                                        <input class="form-control" type="text" id="NameAr-edit-@item.Id"
                                               required="" placeholder="Enter name in arabic" value="@item.NameAr">
                                        <span class="validationNameAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Number-edit-@item.Id" class="form-label">Number:</label>
                                        <input class="form-control" type="number" id="Number-edit-@item.Id"
                                               required="" placeholder="Enter number" value="@item.Number">
                                        <span class="validationNumber text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary all-btn btn-submit" id="EditE_Con_InnerSectionsbtn-@item.Id"
                                                type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete?</p>
                                    <button type="button"
                                            data-id="@item.Id"
                                            class="btn btn-light my-2 deleteE_Con_Inner"
                                            data-bs-dismiss="modal">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="E_Con_InnerForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="NameEn" class="form-label">Name in English:</label>
                        <input class="form-control" type="text" id="NameEn"
                               required="" placeholder="Enter name in english">
                        <span class="validationNameEn text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="NameAr" class="form-label">Name in Arabic:</label>
                        <input class="form-control" type="text" id="NameAr"
                               required="" placeholder="Enter name in arabic">
                        <span class="validationNameAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="Number" class="form-label">Number:</label>
                        <input class="form-control" type="number" id="Number"
                               required="" placeholder="Enter number">
                        <span class="validationNumber text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary all-btn btn-submit" id="SaveE_Con_InnerSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveE_Con_InnerSectionsbtn').click(function () {
            var validation = true;
            var nameEnValue = $('#NameEn').val();
            var nameArValue = $('#NameAr').val();
            var numberValue = $('#Number').val();

            // Validation logic
            if (nameEnValue == "") {
                $(".validationNameEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNameEn").addClass("display-none");
            }
            if (nameArValue == "") {
                $(".validationNameAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNameAr").addClass("display-none");
            }
            if (numberValue == "") {
                $(".validationNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNumber").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("NameEn", nameEnValue);
                formData.append("NameAr", nameArValue);
                formData.append("Number", numberValue);

                $.ajax({
                    url: '@Url.Action("Add", "E_Con_Inner")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                        clearCach();
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
        });

        $(document).on("click", ".deleteE_Con_Inner", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "E_Con_Inner")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                    clearCach();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
            var validation = true;
            var nameEnValue = $('#NameEn-edit-' + itemId).val();
            var nameArValue = $('#NameAr-edit-' + itemId).val();
            var numberValue = $('#Number-edit-' + itemId).val();

            // Validation logic
            if (nameEnValue == "") {
                $(".validationNameEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNameEn").addClass("display-none");
            }
            if (nameArValue == "") {
                $(".validationNameAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNameAr").addClass("display-none");
            }
            if (numberValue == "") {
                $(".validationNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationNumber").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("NameEn", nameEnValue);
                formData.append("NameAr", nameArValue);
                formData.append("Number", numberValue);
                formData.append('id', itemId);

                $.ajax({
                    url: '@Url.Action("Update", "E_Con_Inner")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success-edit").removeClass("display-none");
                        $(".alert-success-edit").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                        clearCach();
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
    }

    function uploadImage(event, itemId) {
        try {
            const imagePreview = $("#imagePreview-edit-" + itemId);

            // Store file specifically for this item
            editModalFiles[itemId] = event.target.files[0] || null;

            // Clear previous preview
            imagePreview.empty();

            if (editModalFiles[itemId]) {
                // Create a container for the image with a delete button
                const imageContainer = $("<div>")
                    .addClass("image-container col-4")
                    .css({
                        "position": "relative",
                        "margin-bottom": "8px"
                    });

                // Create an image element for the selected image
                const img = $("<img>")
                    .attr("src", URL.createObjectURL(editModalFiles[itemId]))
                    .addClass("img-thumbnail")
                    .css("max-width", "150px")
                    .on('error', function() {
                        console.error('Failed to load image preview');
                        imageContainer.remove();
                    });

                // Create a delete button for the image
                const deleteButton = $("<button>")
                    .attr("type", "button")
                    .addClass("btn btn-danger btn-sm")
                    .css({
                        "position": "absolute",
                        "bottom": "0",
                        "right": "0"
                    })
                    .html('<i class="fa-light fa-trash"></i>')
                    .on("click", function () {
                        // Clear the selected file for this specific item
                        delete editModalFiles[itemId];
                        imageContainer.remove();
                        $("#imageInput-edit-" + itemId).val(''); // Clear the file input
                    });

                // Append the image and delete button to the container
                imageContainer.append(img, deleteButton);

                // Append the container to the image preview div
                imagePreview.append(imageContainer);
            }
        } catch (error) {
            console.error('Error in uploadImage function:', error);
            alert('Error uploading image. Please try again.');
        }
    }

    function clearCach(){
        
        $.ajax({
        url: 'https://kh-alqastal.com/api/Common/ClearCach',
        type: 'POST',
        success: function () {
            console.log('Cache cleared successfully:');
        },
        error: function (xhr, status, error) {
            console.error('Error clearing cache:', error);

        }
    });
</script>