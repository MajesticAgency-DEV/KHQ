@model List<KHQ.Domain.ViewModel.AboutUsVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item active">About us section</li>
                        </ol>
                    </div>
                    <h4 class="page-title">About us section</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->
        @if (Model.Count == 0 || Model == null)
        {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->
        }

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="AboutUsId-@item.Id" />
                                <button class="btn btn-xs waves-effect waves-light mt-2 mt-md-0" type="button"
                                        data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight-@item.Id"
                                        aria-controls="offcanvasRight" style="background:#ccc">
                                    <i class="fa-light fa-eye text-white"></i>
                                </button>
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                    data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="col-xl-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <div id="cardCollpase5" class="collapse show">
                                                <div class="table-responsive pt-3">
                                                    <table class="table table-hover table-centered mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>Title in english</th>
                                                                <th>Title in arabic</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>@item.TitleEn</td>
                                                                <td>@item.TitleAr</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div> <!-- end table responsive-->
                                            </div> <!-- collapsed end -->
                                        </div> <!-- end card-body -->
                                    </div> <!-- end card-->
                                </div>
                            </div>                        
                        </div>
                    </div> <!-- end card-->
                </div> <!-- end col-->

                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="AboutUsFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="title-edit-@item.Id" class="form-label">Title in english:</label>
                                        <input class="form-control" type="text" id="title-edit-@item.Id"
                                           required="" placeholder="Enter name of title" value="@item.TitleEn">
                                        <span class="validationTitle text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="titleAr-edit-@item.Id" class="form-label">Title in arabic:</label>
                                        <input class="form-control" type="text" id="titleAr-edit-@item.Id"
                                           required="" placeholder="Enter name of title" value="@item.TitleAr">
                                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="desc-edit-@item.Id" class="form-label">Description in english:</label>
                                        <textarea class="form-control" type="text" id="desc-edit-@item.Id"
                                           required="" placeholder="Enter name of title">@item.DescriptionEn</textarea>
                                        <span class="validationDesc text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="descAr-edit-@item.Id" class="form-label">Description in arabic:</label>
                                        <textarea class="form-control" type="text" id="descAr-edit-@item.Id"
                                           required="" placeholder="Enter name of title">@item.DescriptionAr</textarea>
                                        <span class="validationDescAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditAboutUsSectionsbtn-@item.Id"
                                            type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight-@item.Id" aria-labelledby="offcanvasRightLabel-@item.Id">
                    <div class="offcanvas-header">
                        <div>
                            <h3 id="offcanvasRightLabel-@item.Id">@item.TitleEn</h3>
                            <h3>@item.TitleAr</h3>
                        </div>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <h5 class="mt-3">Description in english:</h5>
                        <p>@item.DescriptionEn</p>
                        <hr />
                        <h5 class="mt-3">Description in arabic:</h5>
                        <p>@item.DescriptionAr</p>
                        <hr />
                    </div>
                </div>
            }
        </div>
        </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="AboutUsForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title in english:</label>
                        <input class="form-control" type="text" id="title"
                           required="" placeholder="Enter name of title">
                        <span class="validationTitle text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="titleAr" class="form-label">Title in arabic:</label>
                        <input class="form-control" type="text" id="titleAr"
                           required="" placeholder="Enter name of title">
                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="desc" class="form-label">Description in english:</label>
                        <textarea class="form-control" type="text" id="desc"
                           required="" placeholder="Enter name of title"></textarea>
                        <span class="validationDesc text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="descAr" class="form-label">Description in arabic:</label>
                        <textarea class="form-control" type="text" id="descAr"
                           required="" placeholder="Enter name of title"></textarea>
                        <span class="validationDescAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveAboutUsSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
$(document).ready(function () {
    $('#SaveAboutUsSectionsbtn').click(function () {
    var validation = true;
    var titleValue = $('#title').val();
    var titleArValue = $('#titleAr').val();
    var descValue = $('#desc').val();
    var descArValue = $('#descAr').val();

    // Validation logic
    if (titleValue == "") {
        $(".validationTitle").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitle").addClass("display-none");
    }
    if (titleArValue == "") {
        $(".validationTitleAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitleAr").addClass("display-none");
    }
    if (descValue == "") {
        $(".validationDesc").removeClass("display-none");
        validation = false;
    } else {
        $(".validationDesc").addClass("display-none");
    }
    if (descArValue == "") {
        $(".validationDescAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationDescAr").addClass("display-none");
    }

    if (validation) {
        var formData = new FormData();
        formData.append("TitleEn", titleValue);
        formData.append("TitleAr", titleArValue);
        formData.append("DescriptionEn", descValue);
        formData.append("DescriptionAr", descArValue);

        $.ajax({
            url: '@Url.Action("Add", "AboutUs")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                $(".alert-success").removeClass("display-none");
                $(".alert-success").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    }
    });

    $(document).on("click", ".deleteAboutUs", function () {
        var id = $(this).data('id');
        var formData = new FormData();
        formData.append('id', id);

        $.ajax({
            url: '@Url.Action("Delete", "AboutUs")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function () {
                location.reload();
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    });
});

function submitForm(fkey) {

}

function saveEdit(itemId) {
    var validation = true;
    
    var titleValue = $('#title-edit-' + itemId).val();
    var titleArValue = $('#titleAr-edit-' + itemId).val();
    var descValue = $('#desc-edit-' + itemId).val();
    var descArValue = $('#descAr-edit-' + itemId).val();

    // Validation logic
    if (titleValue == "") {
        $(".validationTitle").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitle").addClass("display-none");
    }
    if (titleArValue == "") {
        $(".validationTitleAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitleAr").addClass("display-none");
    }
    if (descValue == "") {
        $(".validationDesc").removeClass("display-none");
        validation = false;
    } else {
        $(".validationDesc").addClass("display-none");
    }
    if (descArValue == "") {
        $(".validationDescAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationDescAr").addClass("display-none");
    }

    if (validation) {
        var formData = new FormData();
        formData.append('TitleEn', titleValue);
        formData.append('TitleAr', titleArValue);
        formData.append('DescriptionEn', descValue);
        formData.append('DescriptionAr', descArValue);
        formData.append('id', itemId);

        $.ajax({
            url: '@Url.Action("Update", "AboutUs")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                $(".alert-success-edit").removeClass("display-none");
                $(".alert-success-edit").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    }
}
</script>