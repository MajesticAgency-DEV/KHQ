@model List<KHQ.Domain.Entities.Image>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">>Dashboards /</li>
                            <li class="breadcrumb-item">About us page / </li>
                            <li class="breadcrumb-item active">Cover section</li>
                        </ol>
                    </div>
                    <h4 class="page-title">About us page > Cover section</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        @if (Model.Count == 0)
        {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->   
        }


        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.F_Key" type="hidden" id="CoverSectionId-@item.F_Key" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                    data-bs-target="#edit-modal-@item.F_Key">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                            </div>

                            <div class="bg-light">
                                <img src="@item.PathLink" alt="pic"
                                 class="img-fluid" />
                            </div>
                        </div>
                    </div> <!-- end card-->
                </div> <!-- end col-->

                <div id="edit-modal-@item.F_Key" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="CoverSectionFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="imageInput-edit" class="form-label">Upload image:</label>
                                        <input type="file" id="imageInput-edit-@item.F_Key" class="form-control" onchange="uploadImage(event,'@item.F_Key')">

                                        <div id="imagePreview-edit-@item.F_Key" class="mt-3 row">
                                            <div class="image-container col-4" style="position: relative; margin-bottom: 8px;">
                                                <img src="@item.PathLink" class="img-thumbnail oldSelectedImg-@item.F_Key" style="max-width: 150px;">
                                                <button type="button" class="btn btn-danger btn-sm remove-Img" style="position: absolute; bottom: 0px; right: 2px;"><i class="fa-light fa-trash"></i></button>
                                            </div>
                                            
                                        </div>
                                        <span class="validationImage text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary all-btn btn-submit all-btn" id="EditCoverSectionSectionsbtn-@item.F_Key"
                                            type="button" onclick="saveEdit('@item.F_Key')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="CoverSectionForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="ImageUpload" class="form-label">Upload image:</label>
                        <input type="file" id="imageInput" class="form-control">
                        <div id="imagePreview" class="mt-3 row"></div>

                        <span class="validationImage text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary all-btn btn-submit all-btn" id="SaveCoverSectionSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
// Replace the existing JavaScript with this improved version

var selectedFiles = null;
// Create object to store files for each edit modal separately
var editModalFiles = {};

// Use event delegation for remove buttons to handle dynamically generated content
$(document).on("click", ".remove-Img", function(){
    const $container = $(this).closest('.image-container');
    const $preview = $container.closest('[id^="imagePreview-edit-"]');
    
    // Extract item ID from preview div ID
    const previewId = $preview.attr('id');
    if (previewId) {
        const itemId = previewId.replace('imagePreview-edit-', '');
        // Clear the stored file for this item
        delete editModalFiles[itemId];
    }
    
    $container.remove();
});

$(document).ready(function () {
    // Modified image input change handler for single image (ADD modal)
    $("#imageInput").on("change", function (event) {
        const imagePreview = $("#imagePreview");
        
        selectedFiles = event.target.files[0] || null;
        imagePreview.empty();
        
        if (selectedFiles) {
            const imageContainer = $("<div>").addClass("image-container col-4")
                .css({
                    "position": "relative",
                    "margin-bottom": "8px"
                });
            
            const img = $("<img>")
                .attr("src", URL.createObjectURL(selectedFiles))
                .addClass("img-thumbnail")
                .css("max-width", "150px");

            const deleteButton = $("<button>")
                .attr("type", "button")
                .addClass("btn btn-danger btn-sm")
                .css({
                    "position": "absolute",
                    "bottom": "0",
                    "right": "0"
                })
                .html('<i class="fa-light fa-trash"></i>')
                .on("click", function () {
                    selectedFiles = null;
                    imageContainer.remove();
                    $("#imageInput").val('');
                });

            imageContainer.append(img, deleteButton);
            imagePreview.append(imageContainer);
        }
    });

    $('#SaveCoverSectionSectionsbtn').click(function () {
        var formData = new FormData();

        if (!selectedFiles) {
            $(".validationImage").removeClass("display-none");
        } else {
            $(".validationImage").addClass("display-none");
        }

        if (selectedFiles) {
            formData.append("images", selectedFiles);
        }
        formData.append("imageType", 6);

        $.ajax({
            url: '/api/Common/SaveImages',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                $(".alert-success").removeClass("display-none");
                $(".alert-success").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
                clearCach();
            },
            error: function (xhr, status, error) {
                showError('Error saving images: ' + xhr.responseText);
            }
        });
    });
});

function saveEdit(itemId) {
    var formData = new FormData();
    var oldSelectedFiles = null;
    var oldSelectedFilesDiv = $("img").filter(".oldSelectedImg-" + itemId);

    // Get single old image src
    if (oldSelectedFilesDiv.length > 0) {
        oldSelectedFiles = oldSelectedFilesDiv.eq(0).attr("src");
    }

    // Check for image using the item-specific storage
    if (!editModalFiles[itemId] && !oldSelectedFiles) {
        $(".validationImage").removeClass("display-none");
        return; // Don't proceed if no image
    } else {
        $(".validationImage").addClass("display-none");
    }

    // Append single selected file for this specific item
    if (editModalFiles[itemId]) {
        formData.append("images", editModalFiles[itemId]);
    }
    
    // Append single old image
    if (oldSelectedFiles) {
        formData.append("existingImages", oldSelectedFiles);
    }

    formData.append("imageType", 6);
    formData.append('fKey', itemId);

    $.ajax({
        url: '/api/Common/SaveImages',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (result) {
                $(".alert-success-edit").removeClass("display-none");
                $(".alert-success-edit").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
                clearCach();
        },
        error: function (xhr, status, error) {
            console.error('Error saving images:', xhr.responseText);
            alert('Error saving images. Please try again.');
        }
    });
}

function uploadImage(event, itemId) {
    try {
        const imagePreview = $("#imagePreview-edit-" + itemId);
        
        // Store file specifically for this item
        editModalFiles[itemId] = event.target.files[0] || null;
        
        // Clear previous preview
        imagePreview.empty();

        if (editModalFiles[itemId]) {
            // Create a container for the image with a delete button
            const imageContainer = $("<div>")
                .addClass("image-container col-4")
                .css({
                    "position": "relative",
                    "margin-bottom": "8px"
                });
            
            // Create an image element for the selected image
            const img = $("<img>")
                .attr("src", URL.createObjectURL(editModalFiles[itemId]))
                .addClass("img-thumbnail")
                .css("max-width", "150px")
                .on('error', function() {
                    console.error('Failed to load image preview');
                    imageContainer.remove();
                });

            // Create a delete button for the image
            const deleteButton = $("<button>")
                .attr("type", "button")
                .addClass("btn btn-danger btn-sm")
                .css({
                    "position": "absolute",
                    "bottom": "0",
                    "right": "0"
                })
                .html('<i class="fa-light fa-trash"></i>')
                .on("click", function () {
                    // Clear the selected file for this specific item
                    delete editModalFiles[itemId];
                    imageContainer.remove();
                    $("#imageInput-edit-" + itemId).val(''); // Clear the file input
                });

            // Append the image and delete button to the container
            imageContainer.append(img, deleteButton);

            // Append the container to the image preview div
            imagePreview.append(imageContainer);
        }
    } catch (error) {
        console.error('Error in uploadImage function:', error);
        alert('Error uploading image. Please try again.');
    }
}

function clearCach(){
    
    $.ajax({
    url: 'https://kh-alqastal.com/api/Common/ClearCach',
    type: 'POST',
    success: function () {
        console.log('Cache cleared successfully:');        
    },
    error: function (xhr, status, error) {
        console.error('Error clearing cache:', error);
        
    }
});

}
</script>