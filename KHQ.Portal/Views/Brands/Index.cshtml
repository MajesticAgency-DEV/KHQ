<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="BrandsForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Name in english:</label>
                        <input class="form-control" type="text" id="title"
                               required="" placeholder="Enter name in english">
                        <span class="validationTitle text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="titleAr" class="form-label">Name in arabic:</label>
                        <input class="form-control" type="text" id="titleAr"
                               required="" placeholder="Enter name in arabic">
                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="desc" class="form-label">Description in english:</label>
                        <input class="form-control" type="text" id="desc"
                               required="" placeholder="Enter description in english">
                        <span class="validationDesc text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="descAr" class="form-label">Description in arabic:</label>
                        <input class="form-control" type="text" id="descAr"
                               required="" placeholder="Enter description in arabic">
                        <span class="validationDescAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="faceLink" class="form-label">Facebook link:</label>
                        <input class="form-control" type="text" id="faceLink"
                               required="" placeholder="Enter facebook link">
                        <span class="validationFaceLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="instaLink" class="form-label">Instagram link:</label>
                        <input class="form-control" type="text" id="instaLink"
                               required="" placeholder="Enter instagram link">
                        <span class="validationInstaLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="ImageUpload" class="form-label">Upload image:</label>
                        <input type="file" id="imageInput" class="form-control">
                        <div id="imagePreview" class="mt-3 row"></div>

                        <span class="validationImage text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveBrandsSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    var selectedFiles = [];
    var newImageselectedFilesInEdit = [];

    $(".remove-Img").on("click" , function(){
        this.parentElement.remove()
    })
    $(document).ready(function () {
        var selectedFiles = []; // Initialize an empty array to hold the selected files

        $("#imageInput").on("change", function (event) {
            const imagePreview = $("#imagePreview");
            selectedFiles.push(...this.files);

            // Iterate through selected files
            for (let i = 0; i < event.target.files.length; i++) {
                const file = event.target.files[i];

                // Create a container for each image with a delete button
                const imageContainer = $("<div>").addClass("image-container col-4");
                imageContainer.css("position", "relative")
                imageContainer.css("margin-bottom", "8px")
                // Create an image element for the selected image
                const img = $("<img>")
                    .attr("src", URL.createObjectURL(file))
                    .addClass("img-thumbnail")
                    .css("max-width", "150px");

                // Create a delete button for each image
                const deleteButton = $("<button>")
                    .css("position", "absolute")
                    .css("bottom", "0")
                    .css("right", "0")
                    .html('<i class="fa-light fa-trash"></i>')
                    .addClass("btn btn-danger btn-sm")
                    .on("click", function () {
                        // Remove the image container when the delete button is clicked
                        imageContainer.remove();
                    });

                // Append the image and delete button to the container
                imageContainer.append(img, deleteButton);

                // Append the container to the image preview div
                imagePreview.append(imageContainer);
            }
        });
        $('#SaveBrandsSectionsbtn').click(function () {
           var formData = new FormData();
           var uploadImageValue = selectedFiles;

            if (uploadImageValue.length == 0) {
                $(".validationImage").removeClass("display-none");
            } else {
                $(".validationImage").addClass("display-none");
            }

            // Append each selected file to the FormData object
            for (var i = 0; i < selectedFiles.length; i++) {
                formData.append("images", selectedFiles[i]);
            }
            $.ajax({
                url: '/api/Common/SaveImages',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    submitForm(result.fkey);
                },
                error: function (xhr, status, error) {
                    showError('Error saving images: ' + xhr.responseText, mode, itemId);
                }
            });
        });
        $(document).on("click", ".deleteBrands", function () {
            debugger
            var id = $(this).data('id'); // Use data('id') instead of attr('data_Id')

            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("DeleteConfirmed", "OurCapabilities")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    // Handle the error response here
                    console.log(xhr.responseText);
                }
            });
        });
        });

    function submitForm (fkey){
           var validation = true;
            var titleValue = $('#title').val();
            var titleArValue = $('#titleAr').val();
            var descValue = $('#desc').val();
            var descArValue = $('#descAr').val();
            var faceLinkValue = $('#faceLink').val();
            var instaLinkValue = $('#instaLink').val();

            if (titleValue == "") {
                $(".validationTitle").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitle").addClass("display-none");
            }
            if (titleArValue == "") {
                $(".validationTitleAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleAr").addClass("display-none");
            }
            if (descValue == "") {
                $(".validationDesc").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDesc").addClass("display-none");
            }
            if (descArValue == "") {
                $(".validationDescAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDescAr").addClass("display-none");
            }
            if (faceLinkValue == "") {
                $(".validationFaceLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationFaceLink").addClass("display-none");
            }
            if (instaLinkValue == "") {
                $(".validationInstaLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationInstaLink").addClass("display-none");
            }

            // Add a click event handler for your upload button or form submit
            if (validation) {
                var formData = new FormData();

                formData.append("NameEn", titleValue);
                formData.append("NameAr", titleArValue);
                formData.append("DescriptionEn", descValue);
                formData.append("DescriptionAr", descArValue);
                formData.append("FaceLink", faceLinkValue);
                formData.append("InstaLink", instaLinkValue);

                $.ajax({
                    url: '@Url.Action("Add", "Brands")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        // Wait for 2 seconds and then reload the page
                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        // Handle the error response here
                        console.log(xhr.responseText);
                    }
                });
                }
    }
    function saveEdit(itemId) {
        var validation = true;
        var oldSelectedFiles = [];
        var oldSelectedFilesDiv = $("img").filter(".oldSelectedImg-" + itemId);
        var titleValue = $('#title-edit-' + itemId).val();
        var titleArValue = $('#titleAr-edit-' + itemId).val();
        var descValue = $('#desc-edit-' + itemId).val();
        var descArValue = $('#descAr-edit-' + itemId).val();
        var uploadImageValue = newImageselectedFilesInEdit;
        for (var i = 0; i < oldSelectedFilesDiv.length; i++) {
            oldSelectedFiles.push(oldSelectedFilesDiv.eq(i).attr("src"));
        }
        if (titleValue == "") {
            $(".validationTitle").removeClass("display-none");
            validation = false;
        } else {
            $(".validationTitle").addClass("display-none");
        }
        if (titleArValue == "") {
            $(".validationTitleAr").removeClass("display-none");
            validation = false;
        } else {
            $(".validationTitleAr").addClass("display-none");
        }
        if (descValue == "") {
            $(".validationDesc").removeClass("display-none");
            validation = false;
        } else {
            $(".validationDesc").addClass("display-none");
        }
        if (descArValue == "") {
            $(".validationDescAr").removeClass("display-none");
            validation = false;
        } else {
            $(".validationDescAr").addClass("display-none");
        }
        if (uploadImageValue.length == 0 && oldSelectedFiles.length == 0) {
            $(".validationImage").removeClass("display-none");
            validation = false;
        } else {
            $(".validationImage").addClass("display-none");
        }

        if (validation) {
            var formData = new FormData();
            formData.append('Title', titleValue);
            formData.append('TitleAr', titleArValue);
            formData.append('Description', descValue);
            formData.append('DescriptionAr', descArValue);
            formData.append('id', itemId);

            // Append each selected file to the FormData object
            for (var i = 0; i < uploadImageValue.length; i++) {
                formData.append("ImageUpload", uploadImageValue[i]);
            }
            for (var i = 0; i < oldSelectedFiles.length; i++) {
                formData.append("oldImages", oldSelectedFiles[i]);
            }
            $.ajax({
                url: '@Url.Action("EditOurCapabilities", "OurCapabilities")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    $(".alert-success-edit").removeClass("display-none");
                    $(".alert-success-edit").addClass("d-flex");

                    // Wait for 2 seconds and then reload the page
                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                },
                error: function (xhr, status, error) {
                    // Handle the error response here
                    console.log(xhr.responseText);
                }
            });
        }

    }
    function uploadImage(event, idItem) {
        const imagePreview = $("#imagePreview-edit-" + idItem);
        newImageselectedFilesInEdit.push(...event.target.files)

        // Iterate through selected files
        for (let i = 0; i < event.target.files.length; i++) {
            const file = event.target.files[i];

            // Create a container for each image with a delete button
            const imageContainer = $("<div>").addClass("image-container col-4");
            imageContainer.css("position", "relative")
            imageContainer.css("margin-bottom", "8px")
            // Create an image element for the selected image
            const img = $("<img>")
                .attr("src", URL.createObjectURL(file))
                .addClass("img-thumbnail")
                .css("max-width", "150px");

            // Create a delete button for each image
            const deleteButton = $("<button>")
                .css("position", "absolute")
                .css("bottom", "0")
                .css("right", "0")
                .html('<i class="fa-light fa-trash"></i>')
                .addClass("btn btn-danger btn-sm")
                .on("click", function () {
                    var indexDelete = newImageselectedFilesInEdit.indexOf(...event.target.files);
                    if (indexDelete > -1) { // only splice array when item is found
                        newImageselectedFilesInEdit.splice(indexDelete, 1); // 2nd parameter means remove one item only
                    } 
                    // Remove the image container when the delete button is clicked
                    imageContainer.remove();
                });

            // Append the image and delete button to the container
            imageContainer.append(img, deleteButton);

            // Append the container to the image preview div
            imagePreview.append(imageContainer);
        }
    }
</script>