@model List<KHQ.Domain.ViewModel.H_AboutUsVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">Dashboards / </li>
                            <li class="breadcrumb-item">Home page / </li>
                            <li class="breadcrumb-item active">About us section > Points</li>
                        </ol>
                    </div>
                    <h4 class="page-title">About us section > Points</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-xl-4">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="H_AboutUsId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="row align-items-center">
                                    <div class="col d-flex gap-2">
                                        <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.PointEn</h5>/ <h5 class="font-16 mt-0 sp-line-1 text-dark m-0">@item.PointAr</h5>
                                    </div>
                                    <div class="col d-flex gap-2">
                                        <h3 class="m-0">@Html.Raw(item.Icon)</h3>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div> <!-- end card-->
                </div>

                <!-- Edit Modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="H_AboutUsFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="PointEn-edit-@item.Id" class="form-label">Point in English:</label>
                                        <input class="form-control" type="text" id="PointEn-edit-@item.Id"
                                               required="" placeholder="Enter point in english" value="@item.PointEn">
                                        <span class="validationPointEn text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="PointAr-edit-@item.Id" class="form-label">Point in Arabic:</label>
                                        <input class="form-control" type="text" id="PointAr-edit-@item.Id"
                                               required="" placeholder="Enter point in arabic" value="@item.PointAr">
                                        <span class="validationPointAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Icon-edit-@item.Id" class="form-label">Icon:</label>
                                        <input class="form-control" type="text" id="Icon-edit-@item.Id"
                                               required="" placeholder="Enter icon" value="@item.Icon">
                                        <span class="validationIcon text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditH_AboutUsSectionsbtn-@item.Id"
                                                type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete?</p>
                                    <button type="button"
                                            data-id="@item.Id"
                                            class="btn btn-light my-2 deleteH_AboutUs"
                                            data-bs-dismiss="modal">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="H_AboutUsForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="PointEn" class="form-label">Point in English:</label>
                        <input class="form-control" type="text" id="PointEn"
                               required="" placeholder="Enter point in english">
                        <span class="validationPointEn text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="PointAr" class="form-label">Point in Arabic:</label>
                        <input class="form-control" type="text" id="PointAr"
                               required="" placeholder="Enter point in arabic">
                        <span class="validationPointAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="Icon" class="form-label">Icon:</label>
                        <input class="form-control" type="text" id="Icon"
                               required="" placeholder="Enter icon">
                        <span class="validationIcon text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveH_AboutUsSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveH_AboutUsSectionsbtn').click(function () {
            var validation = true;
            var pointEnValue = $('#PointEn').val();
            var pointArValue = $('#PointAr').val();
            var iconValue = $('#Icon').val();

            // Validation logic
            if (pointEnValue == "") {
                $(".validationPointEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPointEn").addClass("display-none");
            }
            if (pointArValue == "") {
                $(".validationPointAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPointAr").addClass("display-none");
            }
            if (iconValue == "") {
                $(".validationIcon").removeClass("display-none");
                validation = false;
            } else {
                $(".validationIcon").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("PointEn", pointEnValue);
                formData.append("PointAr", pointArValue);
                formData.append("Icon", iconValue);

                $.ajax({
                    url: '@Url.Action("Add", "H_AboutUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
        });

        $(document).on("click", ".deleteH_AboutUs", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "H_AboutUs")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
            var validation = true;
            var pointEnValue = $('#PointEn-edit-' + itemId).val();
            var pointArValue = $('#PointAr-edit-' + itemId).val();
            var iconValue = $('#Icon-edit-' + itemId).val();

            // Validation logic
            if (pointEnValue == "") {
                $(".validationPointEn").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPointEn").addClass("display-none");
            }
            if (pointArValue == "") {
                $(".validationPointAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPointAr").addClass("display-none");
            }
            if (iconValue == "") {
                $(".validationIcon").removeClass("display-none");
                validation = false;
            } else {
                $(".validationIcon").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("PointEn", pointEnValue);
                formData.append("PointAr", pointArValue);
                formData.append("Icon", iconValue);
                formData.append('id', itemId);

                $.ajax({
                    url: '@Url.Action("Update", "H_AboutUs")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success-edit").removeClass("display-none");
                        $(".alert-success-edit").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
    }
</script>