@model List<KHQ.Domain.ViewModel.StainsVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item active">Stains sections</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Stains sections</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-auto">
                                <div class="text-lg-end my-1 my-lg-0">
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                        <i class="fa-regular fa-circle-plus"></i> Add New
                                    </button>
                                </div>
                            </div><!-- end col-->
                        </div> <!-- end row -->
                    </div>
                </div> <!-- end card -->
            </div> <!-- end col-->
        </div>
        <!-- end row-->

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="StainsId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                    data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="row align-items-center">
                                    <div class="col d-flex gap-2">
                                        <h5 class="font-16 mt-0 sp-line-1 text-dark">@item.NameEn</h5>/ <h5 class="font-16 mt-0 sp-line-1 text-dark">@item.NameAr</h5>
                                    </div>
                                </div> <!-- end row -->
                            </div> <!-- end product info-->
                        </div>
                    </div> <!-- end card-->
                </div> <!-- end col-->

                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="StainsFormEdit" enctype="multipart/form-data">

                                    <div class="mb-3">
                                        <label for="title-edit-@item.Id" class="form-label">Name in english:</label>
                                        <input class="form-control" type="text" id="title-edit-@item.Id"
                                           required="" placeholder="Enter name of title" value="@item.NameEn">
                                        <span class="validationTitle text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="titleAr-edit-@item.Id" class="form-label">Name in arabic:</label>
                                        <input class="form-control" type="text" id="titleAr-edit-@item.Id"
                                           required="" placeholder="Enter name of title" value="@item.NameAr">
                                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditStainsSectionsbtn-@item.Id"
                                            type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete ?</p>
                                    <button type="button"
                                        data-id="@item.Id"
                                        class="btn btn-light my-2 deleteStains"
                                        data-bs-dismiss="modal">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="StainsForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Name in english:</label>
                        <input class="form-control" type="text" id="title"
                               required="" placeholder="Enter name in english">
                        <span class="validationTitle text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="titleAr" class="form-label">Name in arabic:</label>
                        <input class="form-control" type="text" id="titleAr"
                               required="" placeholder="Enter name in arabic">
                        <span class="validationTitleAr text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveStainsSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
$(document).ready(function () {
    $('#SaveStainsSectionsbtn').click(function () {
    var validation = true;
    var titleValue = $('#title').val();
    var titleArValue = $('#titleAr').val();

    // Validation logic
    if (titleValue == "") {
        $(".validationTitle").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitle").addClass("display-none");
    }
    if (titleArValue == "") {
        $(".validationTitleAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitleAr").addClass("display-none");
    }

    if (validation) {
        var formData = new FormData();
        formData.append("NameEn", titleValue);
        formData.append("NameAr", titleArValue);

        $.ajax({
            url: '@Url.Action("Add", "Stains")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                $(".alert-success").removeClass("display-none");
                $(".alert-success").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    }
    });

    $(document).on("click", ".deleteStains", function () {
        var id = $(this).data('id');
        var formData = new FormData();
        formData.append('id', id);

        $.ajax({
            url: '@Url.Action("Delete", "Stains")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function () {
                location.reload();
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    });
});

function saveEdit(itemId) {
    var validation = true; 
    var titleValue = $('#title-edit-' + itemId).val();
    var titleArValue = $('#titleAr-edit-' + itemId).val();

    // Validation logic
    if (titleValue == "") {
        $(".validationTitle").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitle").addClass("display-none");
    }
    if (titleArValue == "") {
        $(".validationTitleAr").removeClass("display-none");
        validation = false;
    } else {
        $(".validationTitleAr").addClass("display-none");
    }

    if (validation) {
        var formData = new FormData();
        formData.append('NameEn', titleValue);
        formData.append('NameAr', titleArValue);
        formData.append('id', itemId);

        $.ajax({
            url: '@Url.Action("Update", "Stains")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                $(".alert-success-edit").removeClass("display-none");
                $(".alert-success-edit").addClass("d-flex");

                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    }
}
</script>