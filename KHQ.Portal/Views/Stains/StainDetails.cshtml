@model List<KHQ.Domain.ViewModel.StainDetailsVM>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stain Details Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Quill styles -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .display-none {
            display: none;
        }

        .product-box {
            transition: transform 0.2s;
        }

            .product-box:hover {
                transform: translateY(-5px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .product-action {
            position: absolute;
            right: 15px;
            top: 15px;
            z-index: 10;
        }

        .ql-container {
            font-size: 16px;
            border-bottom-left-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
        }

        .ql-toolbar {
            border-top-left-radius: 0.375rem;
            border-top-right-radius: 0.375rem;
        }

        .card-title {
            font-size: 1.1rem;
        }

        .offcanvas-body h5 {
            color: #3b5de7;
            font-weight: 600;
        }

        .content {
            padding: 20px;
            background-color: #f5f7fb;
        }

        .breadcrumb {
            background-color: transparent;
            padding: 0;
        }

        .page-title-box {
            padding: 20px 0;
        }

        .editor-label {
            margin-bottom: 8px;
            font-weight: 500;
        }

        .validation-message {
            font-size: 0.875rem;
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="content">
        <!-- Start Content-->
        <div class="container-fluid">

            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                                <li class="breadcrumb-item active">Stain details section</li>
                            </ol>
                        </div>
                        <h4 class="page-title">Stain details section</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-end">
                                <div class="col-auto">
                                    <div class="text-lg-end my-1 my-lg-0">
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                                data-bs-target="#add-modal">
                                            <i class="fa-regular fa-circle-plus"></i> Add New
                                        </button>
                                    </div>
                                </div><!-- end col-->
                            </div> <!-- end row -->
                        </div>
                    </div> <!-- end card -->
                </div> <!-- end col-->
            </div>
            <!-- end row-->

            <div class="row" id="stain-details-container">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3 mb-4">
                        <div class="card product-box h-100">
                            <div class="card-body position-relative">
                                <div class="product-action">
                                    <input value="@item.Id" type="hidden" class="stain-detail-id" />
                                    <button class="btn btn-xs btn-light mt-2 mt-md-0 me-1" type="button"
                                            data-bs-toggle="offcanvas" data-bs-target="#offcanvas-@item.Id"
                                            aria-controls="offcanvas-@item.Id">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-success me-1" data-bs-toggle="modal"
                                            data-bs-target="#edit-modal-@item.Id">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#delete-modal-@item.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>

                                <div class="product-info">
                                    <div class="col-12">
                                        <div class="card border-primary border mb-3">
                                            <div class="card-body">
                                                <h5>Stain: @item.StainsVM.NameEn / @item.StainsVM.NameAr</h5>
                                            </div>
                                            <div class="card-body">
                                                <h6 class="card-title text-primary">Title: @item.TitleEn / @item.TitleAr</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Modal for this item -->
                    <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-stain-id="@item.StainsVM.Id">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h4 class="modal-title">Edit Stain Detail</h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-success alert-edit-success display-none" id="edit-success-@item.Id">
                                        <i class="fa-sharp fa-light fa-circle-check"></i> Section updated successfully.
                                    </div>
                                    <form class="stain-detail-edit-form" data-id="@item.Id">
                                        <div class="mb-3">
                                            <label for="section-select-edit-@item.Id" class="form-label">Select stain</label>
                                            <select class="form-select" id="section-select-edit-@item.Id" required>
                                                <option value="">-- Select Stain --</option>
                                                <!-- Options will be loaded dynamically -->
                                            </select>
                                            <div class="invalid-feedback validationStain">Please select a stain</div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="title-en-edit-@item.Id" class="form-label">Title in English:</label>
                                            <input class="form-control" type="text" id="title-en-edit-@item.Id"
                                                   required value="@item.TitleEn" placeholder="Enter title in English">
                                            <div class="invalid-feedback validationTitle">Please provide a title in English</div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="title-ar-edit-@item.Id" class="form-label">Title in Arabic:</label>
                                            <input class="form-control" type="text" id="title-ar-edit-@item.Id"
                                                   required value="@item.TitleAr" placeholder="Enter title in Arabic">
                                            <div class="invalid-feedback validationTitleAr">Please provide a title in Arabic</div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Description in English:</label>
                                            <div id="editor-en-edit-@item.Id" style="height: 200px;"></div>
                                            <div class="invalid-feedback validationDesc">Please provide a description in English</div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Description in Arabic:</label>
                                            <div id="editor-ar-edit-@item.Id" style="height: 200px;"></div>
                                            <div class="invalid-feedback validationDescAr">Please provide a description in Arabic</div>
                                        </div>
                                        <div class="mb-2 text-center">
                                            <button class="btn btn-primary btn-save-edit" type="submit" data-id="@item.Id">
                                                Save Changes
                                            </button>
                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- View Offcanvas for this item -->
                    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvas-@item.Id" aria-labelledby="offcanvas-label-@item.Id">
                        <div class="offcanvas-header">
                            <div>
                                <h5 id="offcanvas-label-@item.Id">@item.StainsVM.NameEn / @item.StainsVM.NameAr</h5>
                            </div>
                            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body">
                            <h5 class="mt-3">Title in English:</h5>
                            <p>@item.TitleEn</p>
                            <hr />
                            <h5 class="mt-3">Title in Arabic:</h5>
                            <p>@item.TitleAr</p>
                            <hr />
                            <h5 class="mt-3">Description in English:</h5>
                            <div class="ql-snow">
                                <div class="ql-editor">@Html.Raw(item.DescriptionEn)</div>
                            </div>
                            <hr />
                            <h5 class="mt-3">Description in Arabic:</h5>
                            <div class="ql-snow">
                                <div class="ql-editor">@Html.Raw(item.DescriptionAr)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Modal for this item -->
                    <div id="delete-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-sm">
                            <div class="modal-content modal-filled bg-danger">
                                <div class="modal-body p-4">
                                    <div class="text-center">
                                        <i class="fas fa-exclamation-triangle text-white fa-2x"></i>
                                        <h4 class="mt-2 text-white">Confirm Deletion</h4>
                                        <p class="mt-3 text-white">Are you sure you want to delete this stain detail?</p>
                                        <button type="button" class="btn btn-light my-2" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-outline-light my-2 btn-confirm-delete" data-id="@item.Id">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Add modal content -->
    <div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Add New Stain Detail</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success alert-add-success display-none">
                        <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                    </div>
                    <form id="stain-details-add-form">
                        <div class="mb-3">
                            <label for="section-select-add" class="form-label">Select stain</label>
                            <select class="form-select" id="section-select-add" required>
                                <option value="">-- Select Stain --</option>
                                <!-- Options will be loaded dynamically -->
                            </select>
                            <div class="invalid-feedback validationStain">Please select a stain</div>
                        </div>
                        <div class="mb-3">
                            <label for="title-en-add" class="form-label">Title in English:</label>
                            <input class="form-control" type="text" id="title-en-add"
                                   required placeholder="Enter title in English">
                            <div class="invalid-feedback validationTitle">Please provide a title in English</div>
                        </div>
                        <div class="mb-3">
                            <label for="title-ar-add" class="form-label">Title in Arabic:</label>
                            <input class="form-control" type="text" id="title-ar-add"
                                   required placeholder="Enter title in Arabic">
                            <div class="invalid-feedback validationTitleAr">Please provide a title in Arabic</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description in English:</label>
                            <div id="editor-en-add" style="height: 200px;"></div>
                            <div class="invalid-feedback validationDesc">Please provide a description in English</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description in Arabic:</label>
                            <div id="editor-ar-add" style="height: 200px;"></div>
                            <div class="invalid-feedback validationDescAr">Please provide a description in Arabic</div>
                        </div>
                        <div class="mb-2 text-center">
                            <button class="btn btn-primary" id="save-stain-details-btn" type="submit">
                                Save
                            </button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize Quill editors for add modal
            const quillEnAdd = new Quill('#editor-en-add', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'color': [] }, { 'background': [] }],
                        ['link', 'image'],
                        ['clean']
                    ]
                },
                placeholder: 'Enter description in English...'
            });

            const quillArAdd = new Quill('#editor-ar-add', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'color': [] }, { 'background': [] }],
                        ['link', 'image'],
                        ['clean']
                    ]
                },
                placeholder: 'أدخل الوصف بالعربية...'
            });

            // Store all Quill instances
            const quillInstances = {
                add: { en: quillEnAdd, ar: quillArAdd }
            };

            // Initialize Quill editors for edit modals
            @foreach (var item in Model)
            {
                    <text>
                    const quillEnEdit_@(item.Id) = new Quill('#editor-en-edit-@item.Id', {
                        theme: 'snow',
                        modules: {
                            toolbar: [
                                [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                [{ 'color': [] }, { 'background': [] }],
                                ['link', 'image'],
                                ['clean']
                            ]
                        }
                    });

                    const quillArEdit_@(item.Id) = new Quill('#editor-ar-edit-@item.Id', {
                        theme: 'snow',
                        modules: {
                            toolbar: [
                                [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                [{ 'color': [] }, { 'background': [] }],
                                ['link', 'image'],
                                ['clean']
                            ]
                        }
                    });

                    // Set content for editors
                    quillEnEdit_@(item.Id).root.innerHTML = '@Html.Raw(item.DescriptionEn)';
                    quillArEdit_@(item.Id).root.innerHTML = '@Html.Raw(item.DescriptionAr)';

                    // Store editors
                    quillInstances['edit-@item.Id'] = {
                        en: quillEnEdit_@(item.Id),
                        ar: quillArEdit_@(item.Id)
                    };
                    </text>
            }

            // Load stains for dropdown
            function loadStains(selectElementId, selectedId = null) {
                $.ajax({
                    url: '@Url.Action("GetAllStains", "Stains")',
                    type: 'GET',
                    success: function(data) {
                        const $select = $(`#${selectElementId}`);
                        $select.empty().append('<option value="">-- Select Stain --</option>');

                        // Handle different response formats
                        const stains = data.$values || data;

                        $.each(stains, function(index, stain) {
                            const selected = selectedId && stain.id == selectedId ? 'selected' : '';
                            $select.append(
                                `<option value="${stain.id}" ${selected}>${stain.nameEn} / ${stain.nameAr}</option>`
                            );
                        });
                    },
                    error: function() {
                        console.error('Failed to load stains');
                    }
                });
            }

            // Handle add form submission
            $('#stain-details-add-form').on('submit', function(e) {
                e.preventDefault();

                const stainId = $('#section-select-add').val();
                const titleEn = $('#title-en-add').val();
                const titleAr = $('#title-ar-add').val();
                const descEn = quillEnAdd.root.innerHTML;
                const descAr = quillArAdd.root.innerHTML;

                // Basic validation
                let isValid = true;

                if (!stainId) {
                    $('.validationStain').show();
                    isValid = false;
                } else {
                    $('.validationStain').hide();
                }

                if (!titleEn) {
                    $('.validationTitle').show();
                    isValid = false;
                } else {
                    $('.validationTitle').hide();
                }

                if (!titleAr) {
                    $('.validationTitleAr').show();
                    isValid = false;
                } else {
                    $('.validationTitleAr').hide();
                }

                if (!descEn || descEn === '<p><br></p>') {
                    $('.validationDesc').show();
                    isValid = false;
                } else {
                    $('.validationDesc').hide();
                }

                if (!descAr || descAr === '<p><br></p>') {
                    $('.validationDescAr').show();
                    isValid = false;
                } else {
                    $('.validationDescAr').hide();
                }

                if (!isValid) {
                    return;
                }

                const formData = new FormData();
                formData.append('StainsId', stainId);
                formData.append('TitleEn', titleEn);
                formData.append('TitleAr', titleAr);
                formData.append('DescriptionEn', descEn);
                formData.append('DescriptionAr', descAr);

                $('#save-stain-details-btn').prop('disabled', true).html('Saving...');

                $.ajax({
                    url: '@Url.Action("Add", "StainDetails")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            $('.alert-add-success').removeClass('display-none');
                            setTimeout(function() {
                                $('#add-modal').modal('hide');
                                location.reload();
                            }, 1500);
                        } else {
                            alert(response.message || 'Failed to add stain detail');
                        }
                    },
                    error: function() {
                        alert('An error occurred while adding the stain detail');
                    },
                    complete: function() {
                        $('#save-stain-details-btn').prop('disabled', false).html('Save');
                    }
                });
            });

            // Handle edit form submission
            $('.stain-detail-edit-form').on('submit', function(e) {
                e.preventDefault();
                const itemId = $(this).data('id');

                const stainId = $(`#section-select-edit-${itemId}`).val();
                const titleEn = $(`#title-en-edit-${itemId}`).val();
                const titleAr = $(`#title-ar-edit-${itemId}`).val();
                const descEn = quillInstances[`edit-${itemId}`].en.root.innerHTML;
                const descAr = quillInstances[`edit-${itemId}`].ar.root.innerHTML;

                // Basic validation
                let isValid = true;

                if (!stainId) {
                    $(`#section-select-edit-${itemId}`).siblings('.validationStain').show();
                    isValid = false;
                } else {
                    $(`#section-select-edit-${itemId}`).siblings('.validationStain').hide();
                }

                if (!titleEn) {
                    $(`#title-en-edit-${itemId}`).siblings('.validationTitle').show();
                    isValid = false;
                } else {
                    $(`#title-en-edit-${itemId}`).siblings('.validationTitle').hide();
                }

                if (!titleAr) {
                    $(`#title-ar-edit-${itemId}`).siblings('.validationTitleAr').show();
                    isValid = false;
                } else {
                    $(`#title-ar-edit-${itemId}`).siblings('.validationTitleAr').hide();
                }

                if (!descEn || descEn === '<p><br></p>') {
                    $(`#editor-en-edit-${itemId}`).siblings('.validationDesc').show();
                    isValid = false;
                } else {
                    $(`#editor-en-edit-${itemId}`).siblings('.validationDesc').hide();
                }

                if (!descAr || descAr === '<p><br></p>') {
                    $(`#editor-ar-edit-${itemId}`).siblings('.validationDescAr').show();
                    isValid = false;
                } else {
                    $(`#editor-ar-edit-${itemId}`).siblings('.validationDescAr').hide();
                }

                if (!isValid) {
                    return;
                }

                const formData = new FormData();
                formData.append('Id', itemId);
                formData.append('StainsId', stainId);
                formData.append('TitleEn', titleEn);
                formData.append('TitleAr', titleAr);
                formData.append('DescriptionEn', descEn);
                formData.append('DescriptionAr', descAr);

                $(`.btn-save-edit[data-id="${itemId}"]`).prop('disabled', true).html('Saving...');

                $.ajax({
                    url: '@Url.Action("Update", "StainDetails")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            $(`#edit-success-${itemId}`).removeClass('display-none');
                            setTimeout(function() {
                                $(`#edit-modal-${itemId}`).modal('hide');
                                location.reload();
                            }, 1500);
                        } else {
                            alert(response.message || 'Failed to update stain detail');
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the stain detail');
                    },
                    complete: function() {
                        $(`.btn-save-edit[data-id="${itemId}"]`).prop('disabled', false).html('Save Changes');
                    }
                });
            });

            // Handle delete confirmation
            $('.btn-confirm-delete').on('click', function() {
                const itemId = $(this).data('id');

                $.ajax({
                    url: '@Url.Action("Delete", "StainDetails")/' + itemId,
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            $(`#delete-modal-${itemId}`).modal('hide');
                            location.reload();
                        } else {
                            alert(response.message || 'Failed to delete stain detail');
                        $(`#delete-modal-${itemId}`).modal('hide');
                        }
                    },
                    error: function() {
                        alert('An error occurred while deleting the stain detail');
                        $(`#delete-modal-${itemId}`).modal('hide');
                    }
                });
            });

            // Load stains for add modal when it's shown
            $('#add-modal').on('show.bs.modal', function() {
                loadStains('section-select-add');
            });

            // Load stains for edit modals when they're shown
            @foreach (var item in Model)
            {
                    <text>
                    $('#edit-modal-@item.Id').on('show.bs.modal', function() {
                        const stainId = $(this).data('stain-id');
                        loadStains('section-select-edit-@item.Id', stainId);
                    });
                    </text>
            }

            // Hide validation messages when fields are filled
            $('input, select, textarea').on('input', function() {
                $(this).siblings('.invalid-feedback').hide();
            });
        });
    </script>
</body>
</html>