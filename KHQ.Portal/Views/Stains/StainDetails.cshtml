@model List<KHQ.Domain.ViewModel.StainDetailsVM>
    <div class="content">

        <!-- Start Content-->
        <div class="container-fluid">

            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                                <li class="breadcrumb-item active">Stain details section</li>
                            </ol>
                        </div>
                        <h4 class="page-title">Stain details section</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-end">
                                <div class="col-auto">
                                    <div class="text-lg-end my-1 my-lg-0">
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#add-modal">
                                            <i class="fa-regular fa-circle-plus"></i> Add New
                                        </button>
                                    </div>
                                </div><!-- end col-->
                            </div> <!-- end row -->
                        </div>
                    </div> <!-- end card -->
                </div> <!-- end col-->
            </div>
            <!-- end row-->

            <div class="row">
                @foreach (var item in Model)
                {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="StainDetailsId-@item.Id" />
                                <button class="btn btn-xs waves-effect waves-light mt-2 mt-md-0" type="button"
                                    data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight-@item.Id"
                                    aria-controls="offcanvasRight" style="background:#ccc">
                                    <i class="fa-light fa-eye text-white"></i>
                                </button>
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light"
                                    data-bs-toggle="modal" data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light"
                                    data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>

                            <div class="product-info">
                                <div class="col-12">
                                    <div class="card border-primary border mb-3">
                                        <div class="card-body">
                                            <h4>Stain name: <br /> @item.StainsVM.NameEn / @item.StainsVM.NameAr</h4>
                                        </div>
                                        <div class="card-body">
                                            <h5 class="card-title text-primary">Title: @item.TitleEn / @item.TitleAr
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- end card-->
                </div> <!-- end col-->

                <!-- UPDATED: Added data-stain-id attribute to edit modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true"
                    data-stain-id="@item.StainsVM.Id">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="StainDetailsFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="section-select-edit-@item.Id" class="form-label">Select
                                            stain</label>
                                        <select class="form-select section-select" id="section-select-edit-@item.Id">
                                            <option value="">-- Select Stain --</option>
                                        </select>
                                        <span class="validationStain text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="title-edit-@item.Id" class="form-label">Title in english:</label>
                                        <input class="form-control" type="text" id="title-edit-@item.Id" required=""
                                            placeholder="Enter name of title" value="@item.TitleEn">
                                        <span class="validationTitle text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="titleAr-edit-@item.Id" class="form-label">Title in arabic:</label>
                                        <input class="form-control" type="text" id="titleAr-edit-@item.Id" required=""
                                            placeholder="Enter name of title" value="@item.TitleAr">
                                        <span class="validationTitleAr text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="desc-edit-@item.Id" class="form-label">Description in
                                            english:</label>
                                        <textarea class="form-control" type="text" id="desc-edit-@item.Id" required=""
                                            placeholder="Enter name of title">@item.DescriptionEn</textarea>
                                        <span class="validationDesc text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="descAr-edit-@item.Id" class="form-label">Description in
                                            arabic:</label>
                                        <textarea class="form-control" type="text" id="descAr-edit-@item.Id" required=""
                                            placeholder="Enter name of title">@item.DescriptionAr</textarea>
                                        <span class="validationDescAr text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="imageInput-edit" class="form-label">Upload image:</label>
                                        <input type="file" id="imageInput-edit-@item.Id" class="form-control"
                                            onchange="uploadImage(event,'@item.Id')">

                                        <div id="imagePreview-edit-@item.Id" class="mt-3 row">
                                            <div class="image-container col-4"
                                                style="position: relative; margin-bottom: 8px;">
                                                <img src="@item.ImageLink" class="img-thumbnail oldSelectedImg-@item.Id"
                                                    style="max-width: 150px;">
                                                <button type="button" class="btn btn-danger btn-sm remove-Img"
                                                    style="position: absolute; bottom: 0px; right: 2px;"><i
                                                        class="fa-light fa-trash"></i></button>
                                            </div>

                                        </div>
                                        <span class="validationImage text-danger display-none">* this field is
                                            required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary all-btn btn-submit"
                                            id="EditStainDetailsSectionsbtn-@item.Id" type="button"
                                            onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight-@item.Id"
                    aria-labelledby="offcanvasRightLabel-@item.Id">
                    <div class="offcanvas-header">
                        <div>
                            <h3 id="offcanvasRightLabel-@item.Id">@item.StainsVM.NameEn</h3>
                            <h3>@item.StainsVM.NameAr</h3>
                        </div>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
                            aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <h5 class="mt-3">Title in english:</h5>
                        <p>@item.TitleEn</p>
                        <hr />
                        <h5 class="mt-3">Title in arabic:</h5>
                        <p>@item.TitleAr</p>
                        <hr />
                        <h5 class="mt-3">Description in english:</h5>
                        <p>@item.DescriptionEn</p>
                        <hr />
                        <h5 class="mt-3">Description in arabic:</h5>
                        <p>@item.DescriptionAr</p>
                        <hr />
                        <div class="row row-gap-3">
                            <div class="col-12">
                                <img src="@item.ImageLink" style="width: 100%;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete ?</p>
                                    <button type="button" data-id="@item.Id"
                                        class="btn btn-light my-2 deleteStainDetails"
                                        data-bs-dismiss="modal">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>

    <!-- Add modal content -->
    <div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="alert alert-success display-none">
                        <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                    </div>
                    <form id="StainDetailsForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="section-select-add" class="form-label">Select stain</label>
                            <select class="form-select section-select" id="section-select-add">
                                <option value="">-- Select Section --</option>
                            </select>
                            <span class="validationStain text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-3">
                            <label for="title" class="form-label">Title in english:</label>
                            <input class="form-control" type="text" id="title" required=""
                                placeholder="Enter name of title">
                            <span class="validationTitle text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-3">
                            <label for="titleAr" class="form-label">Title in arabic:</label>
                            <input class="form-control" type="text" id="titleAr" required=""
                                placeholder="Enter name of title">
                            <span class="validationTitleAr text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-3">
                            <label for="desc" class="form-label">Description in english:</label>
                            <textarea class="form-control" type="text" id="desc" required=""
                                placeholder="Enter name of title"></textarea>
                            <span class="validationDesc text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-3">
                            <label for="descAr" class="form-label">Description in arabic:</label>
                            <textarea class="form-control" type="text" id="descAr" required=""
                                placeholder="Enter name of title"></textarea>
                            <span class="validationDescAr text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-3">
                            <label for="ImageUpload" class="form-label">Upload image:</label>
                            <input type="file" id="imageInput" class="form-control">
                            <div id="imagePreview" class="mt-3 row"></div>

                            <span class="validationImage text-danger display-none">* this field is required</span>
                        </div>
                        <div class="mb-2 text-center">
                            <button class="btn btn-primary all-btn btn-submit" id="SaveStainDetailsSectionsbtn" type="button">
                                Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

    <script>
        // Replace the existing JavaScript with this improved version

        var selectedFiles = null;
        // Create object to store files for each edit modal separately
        var editModalFiles = {};

        // Use event delegation for remove buttons to handle dynamically generated content
        $(document).on("click", ".remove-Img", function () {
            const $container = $(this).closest('.image-container');
            const $preview = $container.closest('[id^="imagePreview-edit-"]');

            // Extract item ID from preview div ID
            const previewId = $preview.attr('id');
            if (previewId) {
                const itemId = previewId.replace('imagePreview-edit-', '');
                // Clear the stored file for this item
                delete editModalFiles[itemId];
            }

            $container.remove();
        });

        $(document).ready(function () {

            // Modified image input change handler for single image (ADD modal)
            $("#imageInput").on("change", function (event) {
                const imagePreview = $("#imagePreview");

                selectedFiles = event.target.files[0] || null;
                imagePreview.empty();

                if (selectedFiles) {
                    const imageContainer = $("<div>").addClass("image-container col-4")
                        .css({
                            "position": "relative",
                            "margin-bottom": "8px"
                        });

                    const img = $("<img>")
                        .attr("src", URL.createObjectURL(selectedFiles))
                        .addClass("img-thumbnail")
                        .css("max-width", "150px");

                    const deleteButton = $("<button>")
                        .attr("type", "button")
                        .addClass("btn btn-danger btn-sm")
                        .css({
                            "position": "absolute",
                            "bottom": "0",
                            "right": "0"
                        })
                        .html('<i class="fa-light fa-trash"></i>')
                        .on("click", function () {
                            selectedFiles = null;
                            imageContainer.remove();
                            $("#imageInput").val('');
                        });

                    imageContainer.append(img, deleteButton);
                    imagePreview.append(imageContainer);
                }
            });

            // Load stains when page loads (for add modal)
            loadStrainsForDropdown('#section-select-add');

            // Reload stains when add modal opens
            $('#add-modal').on('show.bs.modal', function () {
                loadStrainsForDropdown('#section-select-add');
            });

            // Load stains with pre-selection when edit modal opens
            $('[id^="edit-modal-"]').on('show.bs.modal', function () {
                var modal = $(this);
                var stainId = modal.data('stain-id'); // Get the stain ID from data attribute
                var modalId = modal.attr('id').replace('edit-modal-', '');
                var dropdownSelector = '#section-select-edit-' + modalId;

                // Load stains and pre-select the current stain
                loadStrainsForDropdown(dropdownSelector, stainId);
            });

            // Save functionality for add
            $('#SaveStainDetailsSectionsbtn').click(function () {
                var formData = new FormData();

                if (!selectedFiles) {
                    $(".validationImage").removeClass("display-none");
                } else {
                    $(".validationImage").addClass("display-none");
                }

                if (selectedFiles) {
                    formData.append("images", selectedFiles);
                }
                formData.append("imageType", 11);

                $.ajax({
                    url: '/api/Common/SaveImages',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        submitForm(result.fkey);
                    },
                    error: function (xhr, status, error) {
                        showError('Error saving images: ' + xhr.responseText);
                    }
                });
            });

            // Delete functionality
            $(document).on("click", ".deleteStainDetails", function () {
                var id = $(this).data('id');
                var formData = new FormData();
                formData.append('id', id);

                $.ajax({
                    url: '@Url.Action("Delete", "StainDetails")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response && response.success) {
                            location.reload();
                        } else {
                            location.reload(); // Still reload even if no JSON response for compatibility
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        alert("An error occurred while deleting stain details");
                    }
                });
            });
        });

        function submitForm(fkey) {
            var validation = true;
            var titleValue = $('#title').val();
            var titleArValue = $('#titleAr').val();
            var descValue = $('#desc').val();
            var descArValue = $('#descAr').val();
            var selectedStain = $('#section-select-add').val();

            // Validation logic
            if (titleValue == "") {
                $(".validationTitle").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitle").addClass("display-none");
            }
            if (titleArValue == "") {
                $(".validationTitleAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleAr").addClass("display-none");
            }
            if (descValue == "") {
                $(".validationDesc").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDesc").addClass("display-none");
            }
            if (descArValue == "") {
                $(".validationDescAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDescAr").addClass("display-none");
            }
            if (selectedStain == "") {
                $(".validationStain").removeClass("display-none");
                validation = false;
            } else {
                $(".validationStain").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("TitleEn", titleValue);
                formData.append("TitleAr", titleArValue);
                formData.append("DescriptionEn", descValue);
                formData.append("DescriptionAr", descArValue);
                formData.append("StainsId", selectedStain);
                formData.append('id', fkey);

                $.ajax({
                    url: '@Url.Action("Add", "StainDetails")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $(".alert-success").removeClass("display-none");
                            $(".alert-success").addClass("d-flex");

                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            alert(response.message || "Failed to add stain details");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        alert("An error occurred while adding stain details");
                    }
                });
            }
        }
        // Updated function to load stains for specific dropdown with optional pre-selection
        function loadStrainsForDropdown(dropdownSelector, selectedStainId = null) {
            $.ajax({
                url: '@Url.Action("GetAllStains", "Stains")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $(dropdownSelector).empty();
                    $(dropdownSelector).append('<option value="">-- Select Section --</option>');

                    // Handle different response formats
                    var stains = data.$values || data;

                    $.each(stains, function (index, stain) {
                        var isSelected = selectedStainId && stain.id == selectedStainId ? 'selected' : '';
                        $(dropdownSelector).append(
                            '<option value="' + stain.id + '" ' + isSelected + '>' +
                            stain.nameEn + ' / ' + stain.nameAr + '</option>'
                        );
                    });
                },
                error: function (xhr, status, error) {
                    console.log('Error loading stains: ' + xhr.responseText);
                    $(dropdownSelector).empty();
                    $(dropdownSelector).append('<option value="">Error loading sections</option>');
                }
            });
        }

        // Updated edit save function
        function saveEdit(itemId) {
            var formData = new FormData();
            var oldSelectedFiles = null;
            var oldSelectedFilesDiv = $("img").filter(".oldSelectedImg-" + itemId);

            // Get single old image src
            if (oldSelectedFilesDiv.length > 0) {
                oldSelectedFiles = oldSelectedFilesDiv.eq(0).attr("src");
            }

            // Check for image using the item-specific storage
            if (!editModalFiles[itemId] && !oldSelectedFiles) {
                $(".validationImage").removeClass("display-none");
                return; // Don't proceed if no image
            } else {
                $(".validationImage").addClass("display-none");
            }

            // Append single selected file for this specific item
            if (editModalFiles[itemId]) {
                formData.append("images", editModalFiles[itemId]);
            }

            // Append single old image
            if (oldSelectedFiles) {
                formData.append("existingImages", oldSelectedFiles);
            }

            formData.append("imageType", 11);
            formData.append('fKey', itemId);

            $.ajax({
                url: '/api/Common/SaveImages',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    editForm(result.fkey);
                },
                error: function (xhr, status, error) {
                    console.error('Error saving images:', xhr.responseText);
                    alert('Error saving images. Please try again.');
                }
            });
        }
        function editForm(itemId) {
            var validation = true;

            var titleValue = $('#title-edit-' + itemId).val();
            var titleArValue = $('#titleAr-edit-' + itemId).val();
            var descValue = $('#desc-edit-' + itemId).val();
            var descArValue = $('#descAr-edit-' + itemId).val();
            var selectedStain = $('#section-select-edit-' + itemId).val();

            // Validation logic
            if (titleValue == "") {
                $(".validationTitle").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitle").addClass("display-none");
            }
            if (titleArValue == "") {
                $(".validationTitleAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationTitleAr").addClass("display-none");
            }
            if (descValue == "") {
                $(".validationDesc").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDesc").addClass("display-none");
            }
            if (descArValue == "") {
                $(".validationDescAr").removeClass("display-none");
                validation = false;
            } else {
                $(".validationDescAr").addClass("display-none");
            }
            if (selectedStain == "") {
                $(".validationStain").removeClass("display-none");
                validation = false;
            } else {
                $(".validationStain").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append('TitleEn', titleValue);
                formData.append('TitleAr', titleArValue);
                formData.append('DescriptionEn', descValue);
                formData.append('DescriptionAr', descArValue);
                formData.append('id', itemId);
                formData.append('StainsId', selectedStain);

                $.ajax({
                    url: '@Url.Action("Update", "StainDetails")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $(".alert-success-edit").removeClass("display-none");
                            $(".alert-success-edit").addClass("d-flex");

                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            alert(response.message || "Failed to update stain details");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        alert("An error occurred while updating stain details");
                    }
                });
            }
        }

        function uploadImage(event, itemId) {
            try {
                const imagePreview = $("#imagePreview-edit-" + itemId);

                // Store file specifically for this item
                editModalFiles[itemId] = event.target.files[0] || null;

                // Clear previous preview
                imagePreview.empty();

                if (editModalFiles[itemId]) {
                    // Create a container for the image with a delete button
                    const imageContainer = $("<div>")
                        .addClass("image-container col-4")
                        .css({
                            "position": "relative",
                            "margin-bottom": "8px"
                        });

                    // Create an image element for the selected image
                    const img = $("<img>")
                        .attr("src", URL.createObjectURL(editModalFiles[itemId]))
                        .addClass("img-thumbnail")
                        .css("max-width", "150px")
                        .on('error', function () {
                            console.error('Failed to load image preview');
                            imageContainer.remove();
                        });

                    // Create a delete button for the image
                    const deleteButton = $("<button>")
                        .attr("type", "button")
                        .addClass("btn btn-danger btn-sm")
                        .css({
                            "position": "absolute",
                            "bottom": "0",
                            "right": "0"
                        })
                        .html('<i class="fa-light fa-trash"></i>')
                        .on("click", function () {
                            // Clear the selected file for this specific item
                            delete editModalFiles[itemId];
                            imageContainer.remove();
                            $("#imageInput-edit-" + itemId).val(''); // Clear the file input
                        });

                    // Append the image and delete button to the container
                    imageContainer.append(img, deleteButton);

                    // Append the container to the image preview div
                    imagePreview.append(imageContainer);
                }
            } catch (error) {
                console.error('Error in uploadImage function:', error);
                alert('Error uploading image. Please try again.');
            }
        }
    </script>