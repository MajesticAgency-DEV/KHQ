@model List<KHQ.Domain.ViewModel.SocialMediaVM>
<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">Dashboards / </li>
                            <li class="breadcrumb-item active">Social media section</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Social media section</h4>
                </div>
            </div>
        </div>
        <!-- end page title -->
        @if(Model.Count == 0 || Model == null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-end">
                                <div class="col-auto">
                                    <div class="text-lg-end my-1 my-lg-0">
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                                data-bs-target="#add-modal">
                                            <i class="fa-regular fa-circle-plus"></i> Add New
                                        </button>
                                    </div>
                                </div><!-- end col-->
                            </div> <!-- end row -->
                        </div>
                    </div> <!-- end card -->
                </div> <!-- end col-->
            </div>
            <!-- end row-->
        }
        <div class="row">
            @foreach (var item in Model)
            {

                <div class="col-xl-12">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <input value="@item.Id" type="hidden" id="H_AboutUsId-@item.Id" />
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Email: @item.Email</h5>
                                    <p class="card-text">Phone: @item.PhoneNumber</p>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">Address: @item.Address</li>
                                </ul>
                                <div class="card-body d-flex gap-3">
                                    <a href="@item.FaceLink" target="_blank" class="text-custom"><i class="fa-brands fa-facebook"></i> Facebook</a>
                                    <a href="@item.InstaLink" target="_blank" class="text-custom"><i class="fa-brands fa-instagram"></i> Instegram</a>
                                    <a href="@item.WhatsAppLink" target="_blank" class="text-custom"><i class="fa-brands fa-whatsapp"></i> Whatsapp</a>
                                    <a href="@item.WebSiteLink" target="_blank" class="text-custom"><i class="fa-regular fa-globe"></i> Website</a>
                                </div>
                            </div>

                        </div>
                    </div> <!-- end card-->
                </div>


                <!-- Edit Modal -->
                <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="alert alert-success alert-success-edit display-none">
                                    <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                </div>
                                <form id="SocialMediaFormEdit" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <label for="Email-edit-@item.Id" class="form-label">Email:</label>
                                        <input class="form-control" type="text" id="Email-edit-@item.Id"
                                               required="" placeholder="Enter email" value="@item.Email">
                                        <span class="validationEmail text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="Address-edit-@item.Id" class="form-label">Address:</label>
                                        <input class="form-control" type="text" id="Address-edit-@item.Id"
                                               required="" placeholder="Enter address" value="@item.Address">
                                        <span class="validationAddress text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="PhoneNumber-edit-@item.Id" class="form-label">Phone Number:</label>
                                        <input class="form-control" type="text" id="PhoneNumber-edit-@item.Id"
                                               required="" placeholder="Enter phone number" value="@item.PhoneNumber">
                                        <span class="validationPhoneNumber text-danger display-none">* this field is required</span>
                                    </div>
                                    <hr />
                                    <div class="mb-3">
                                        <label for="WhatsAppLink-edit-@item.Id" class="form-label">Whatsapp Link:</label>
                                        <input class="form-control" type="text" id="WhatsAppLink-edit-@item.Id"
                                               required="" placeholder="Enter whatsapp link" value="@item.WhatsAppLink">
                                        <span class="validationWhatsAppLink text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="InstaLink-edit-@item.Id" class="form-label">Instagram Link:</label>
                                        <input class="form-control" type="text" id="InstaLink-edit-@item.Id"
                                               required="" placeholder="Enter Instagram link" value="@item.InstaLink">
                                        <span class="validationInstaLink text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="FaceLink-edit-@item.Id" class="form-label">Facebook Link:</label>
                                        <input class="form-control" type="text" id="FaceLink-edit-@item.Id"
                                               required="" placeholder="Enter facebook link" value="@item.FaceLink">
                                        <span class="validationFaceLink text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-3">
                                        <label for="WebSiteLink-edit-@item.Id" class="form-label">Website Link:</label>
                                        <input class="form-control" type="text" id="WebSiteLink-edit-@item.Id"
                                               required="" placeholder="Enter website link" value="@item.WebSiteLink">
                                        <span class="validationWebSiteLink text-danger display-none">* this field is required</span>
                                    </div>
                                    <div class="mb-2 text-center">
                                        <button class="btn btn-primary btn-submit" id="EditSocialMediaSectionsbtn-@item.Id"
                                                type="button" onclick="saveEdit('@item.Id')">
                                            Save
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content modal-filled bg-danger">
                            <div class="modal-body p-4">
                                <div class="text-center">
                                    <i class="fa-regular fa-ban text-white font-36"></i>
                                    <h4 class="mt-2 text-white">Oh snap!</h4>
                                    <p class="mt-3 text-white">Are you sure you want to delete?</p>
                                    <button type="button"
                                            data-id="@item.Id"
                                            class="btn btn-light my-2 deleteSocialMedia"
                                            data-bs-dismiss="modal">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="SocialMediaForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="Email" class="form-label">Email:</label>
                        <input class="form-control" type="text" id="Email"
                               required="" placeholder="Enter email">
                        <span class="validationEmail text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="Address" class="form-label">Address:</label>
                        <input class="form-control" type="text" id="Address"
                               required="" placeholder="Enter address">
                        <span class="validationAddress text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="PhoneNumber" class="form-label">Phone Number:</label>
                        <input class="form-control" type="text" id="PhoneNumber"
                               required="" placeholder="Enter phone number">
                        <span class="validationPhoneNumber text-danger display-none">* this field is required</span>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <label for="WhatsAppLink" class="form-label">Whatsapp Link:</label>
                        <input class="form-control" type="text" id="WhatsAppLink"
                               required="" placeholder="Enter whatsapp link">
                        <span class="validationWhatsAppLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="InstaLink" class="form-label">Instagram Link:</label>
                        <input class="form-control" type="text" id="InstaLink"
                               required="" placeholder="Enter Instagram link">
                        <span class="validationInstaLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="FaceLink" class="form-label">Facebook Link:</label>
                        <input class="form-control" type="text" id="FaceLink"
                               required="" placeholder="Enter facebook link">
                        <span class="validationFaceLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-3">
                        <label for="WebSiteLink" class="form-label">Website Link:</label>
                        <input class="form-control" type="text" id="WebSiteLink"
                               required="" placeholder="Enter website link">
                        <span class="validationWebSiteLink text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary btn-submit" id="SaveSocialMediaSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveSocialMediaSectionsbtn').click(function () {
            var validation = true;
            var emailValue = $('#Email').val();
            var addressValue = $('#Address').val();
            var phoneNumberValue = $('#PhoneNumber').val();
            var whatsAppLinkValue = $('#WhatsAppLink').val();
            var instaLinkValue = $('#InstaLink').val();
            var faceLinkValue = $('#FaceLink').val();
            var webSiteLinkValue = $('#WebSiteLink').val();

            // Validation logic
            if (emailValue == "") {
                $(".validationEmail").removeClass("display-none");
                validation = false;
            } else {
                $(".validationEmail").addClass("display-none");
            }
            if (addressValue == "") {
                $(".validationAddress").removeClass("display-none");
                validation = false;
            } else {
                $(".validationAddress").addClass("display-none");
            }
            if (phoneNumberValue == "") {
                $(".validationPhoneNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPhoneNumber").addClass("display-none");
            }
            if (whatsAppLinkValue == "") {
                $(".validationWhatsAppLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationWhatsAppLink").addClass("display-none");
            }
            if (instaLinkValue == "") {
                $(".validationInstaLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationInstaLink").addClass("display-none");
            }
            if (faceLinkValue == "") {
                $(".validationFaceLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationFaceLink").addClass("display-none");
            }
            if (webSiteLinkValue == "") {
                $(".validationWebSiteLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationWebSiteLink").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("Email", emailValue);
                formData.append("Address", addressValue);
                formData.append("PhoneNumber", phoneNumberValue);
                formData.append("WhatsAppLink", whatsAppLinkValue);
                formData.append("InstaLink", instaLinkValue);
                formData.append("FaceLink", faceLinkValue);
                formData.append("WebSiteLink", webSiteLinkValue);

                $.ajax({
                    url: '@Url.Action("Add", "SocialMedia")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success").removeClass("display-none");
                        $(".alert-success").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
        });

        $(document).on("click", ".deleteSocialMedia", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "SocialMedia")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
            var validation = true;
            var emailValue = $('#Email-edit-' + itemId).val();
            var addressValue = $('#Address-edit-' + itemId).val();
            var phoneNumberValue = $('#PhoneNumber-edit-' + itemId).val();
            var whatsAppLinkValue = $('#WhatsAppLink-edit-' + itemId).val();
            var instaLinkValue = $('#InstaLink-edit-' + itemId).val();
            var faceLinkValue = $('#FaceLink-edit-' + itemId).val();
            var webSiteLinkValue = $('#WebSiteLink-edit-' + itemId).val();

            // Validation logic
            if (emailValue == "") {
                $(".validationEmail").removeClass("display-none");
                validation = false;
            } else {
                $(".validationEmail").addClass("display-none");
            }
            if (addressValue == "") {
                $(".validationAddress").removeClass("display-none");
                validation = false;
            } else {
                $(".validationAddress").addClass("display-none");
            }
            if (phoneNumberValue == "") {
                $(".validationPhoneNumber").removeClass("display-none");
                validation = false;
            } else {
                $(".validationPhoneNumber").addClass("display-none");
            }
            if (whatsAppLinkValue == "") {
                $(".validationWhatsAppLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationWhatsAppLink").addClass("display-none");
            }
            if (instaLinkValue == "") {
                $(".validationInstaLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationInstaLink").addClass("display-none");
            }
            if (faceLinkValue == "") {
                $(".validationFaceLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationFaceLink").addClass("display-none");
            }
            if (webSiteLinkValue == "") {
                $(".validationWebSiteLink").removeClass("display-none");
                validation = false;
            } else {
                $(".validationWebSiteLink").addClass("display-none");
            }

            if (validation) {
                var formData = new FormData();
                formData.append("Email", emailValue);
                formData.append("Address", addressValue);
                formData.append("PhoneNumber", phoneNumberValue);
                formData.append("WhatsAppLink", whatsAppLinkValue);
                formData.append("InstaLink", instaLinkValue);
                formData.append("FaceLink", faceLinkValue);
                formData.append("WebSiteLink", webSiteLinkValue);
                formData.append('id', itemId);

                $.ajax({
                    url: '@Url.Action("Update", "SocialMedia")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $(".alert-success-edit").removeClass("display-none");
                        $(".alert-success-edit").addClass("d-flex");

                        setTimeout(function () {
                            location.reload();
                        }, 1000);
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                });
            }
    }
</script>