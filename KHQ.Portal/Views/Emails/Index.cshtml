@model List<KHQ.Domain.ViewModel.EmailsVM>
<div class="content">
    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">Dashboards / </li>
                            <li class="breadcrumb-item active">Emails page</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Emails page</h4>
                </div>
            </div>
        </div>
        <div class="row">
                <div class="col-12">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-info">
                                <div class="col-xl-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <div id="cardCollpase5" class="collapse show">
                                                <div class="table-responsive pt-3">
                                                    <table class="table table-hover table-centered mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>Name</th>
                                                                <th>Email</th>
                                                                <th>Phone</th>
                                                                <th>Subject</th>
                                                                <th>Message</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in Model)
                                                            {
                                                            <tr>
                                                                <td>@item.Name</td>
                                                                <td>@item.SentEmail</td>
                                                                <td>@item.Phone</td>
                                                                <td>@item.Subject</td>
                                                                <td>@item.Message</td>
                                                                <td>
                                                                    <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                                                        <i class="fa-sharp fa-light fa-trash"></i>
                                                                    </button>

                                                                    <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                                                                        <div class="modal-dialog modal-sm">
                                                                            <div class="modal-content modal-filled bg-danger">
                                                                                <div class="modal-body p-4">
                                                                                    <div class="text-center">
                                                                                        <i class="fa-regular fa-ban text-white font-36"></i>
                                                                                        <h4 class="mt-2 text-white">Oh snap!</h4>
                                                                                        <p class="mt-3 text-white">Are you sure you want to delete ?</p>
                                                                                        <button type="button"
                                                                                                data-id="@item.Id"
                                                                                                class="btn btn-light my-2 deleteEmails"
                                                                                                data-bs-dismiss="modal">
                                                                                            Continue
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div> <!-- end table responsive-->
                                            </div> <!-- collapsed end -->
                                        </div> <!-- end card-body -->
                                    </div> <!-- end card-->
                                </div>
                            </div>                        
                        </div>
                    </div> <!-- end card-->
                </div> <!-- end col-->
        </div>
        </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
$(document).ready(function () {
        $(document).on("click", ".deleteEmails", function () {
        var id = $(this).data('id');
        var formData = new FormData();
        formData.append('id', id);

        $.ajax({
                url: '@Url.Action("Delete", "Emails")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function () {
                location.reload();
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
            }
        });
    });
});
</script>