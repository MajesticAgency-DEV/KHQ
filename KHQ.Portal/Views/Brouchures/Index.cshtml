@model List<KHQ.Domain.ViewModel.BrouchuresVM>

<div class="content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/">Dashboards / </a></li>
                            <li class="breadcrumb-item active">Brouchures</li>
                        </ol>
                    </div>
                    <h4 class="page-title">Brouchures</h4>
                </div>
            </div>
        </div>

        <!-- Add Button -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body d-flex justify-content-end">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#add-modal">
                            <i class="fa-regular fa-circle-plus"></i> Add New
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Brouchures List -->
        <div class="row" id="brouchures-list">
            @foreach (var item in Model)
            {
                <div class="col-xl-4" id="brouchure-card-@item.Id">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <button type="button" class="btn btn-success btn-xs" onclick="openEditModal('@item.Id')">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs" onclick="openDeleteModal('@item.Id')">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>
                            <div class="mt-3">
                                <h5>@item.TitleEn / @item.TitleAr</h5>
                                <p>@item.DescriptionEn</p>
                                <p>@item.DescriptionAr</p>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <button class="btn btn-primary btn-sm" onclick="downloadFile('@item.Id')">
                                        <i class="fa-regular fa-download"></i> Download
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Modal -->
<div id="add-modal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <form id="addForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label>Title (EN)</label>
                        <input class="form-control" type="text" id="TitleEn" required />
                    </div>
                    <div class="mb-3">
                        <label>Title (AR)</label>
                        <input class="form-control" type="text" id="TitleAr" required />
                    </div>
                    <div class="mb-3">
                        <label>Description (EN)</label>
                        <textarea class="form-control" id="DescriptionEn"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>Description (AR)</label>
                        <textarea class="form-control" id="DescriptionAr"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>PDF File</label>
                        <input class="form-control" type="file" id="File" accept="application/pdf" required />
                    </div>
                    <div class="text-center">
                        <button type="button" id="SaveBrouchureBtn" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Single Edit Modal -->
<div id="edit-modal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <form id="editForm" enctype="multipart/form-data">
                    <input type="hidden" id="EditId" />
                    <div class="mb-3">
                        <label>Title (EN)</label>
                        <input class="form-control" id="EditTitleEn" />
                    </div>
                    <div class="mb-3">
                        <label>Title (AR)</label>
                        <input class="form-control" id="EditTitleAr" />
                    </div>
                    <div class="mb-3">
                        <label>Description (EN)</label>
                        <textarea class="form-control" id="EditDescriptionEn"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>Description (AR)</label>
                        <textarea class="form-control" id="EditDescriptionAr"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>PDF File (optional)</label>
                        <input type="file" class="form-control" id="EditFile" accept="application/pdf" />
                        <div id="EditFileLink" class="mt-1"></div>
                    </div>
                    <div class="text-center">
                        <button type="button" class="btn btn-primary" id="UpdateBrouchureBtn">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Single Delete Modal -->
<div id="delete-modal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content modal-filled bg-danger">
            <div class="modal-body p-4 text-center">
                <i class="fa-regular fa-ban text-white font-36"></i>
                <h4 class="mt-2 text-white">Confirm Delete?</h4>
                <div class="text-center">
                    <button type="button" class="btn btn-light my-2" id="ConfirmDeleteBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Add brochure
        $('#SaveBrouchureBtn').click(function () {
            var formData = new FormData();
            formData.append("TitleEn", $('#TitleEn').val());
            formData.append("TitleAr", $('#TitleAr').val());
            formData.append("DescriptionEn", $('#DescriptionEn').val());
            formData.append("DescriptionAr", $('#DescriptionAr').val());
            formData.append("file", $('#File')[0].files[0]);

            $.ajax({
                url: '@Url.Action("Add", "Brouchures")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () { location.reload(); },
                error: function (xhr) { alert("Error: " + xhr.responseText); }
            });
        });

        // Open Edit Modal and fetch data
                           function openEditModal(id) {

            $.get("Get" + '/' + id, function(data) {
                $('#EditId').val(data.id);
                $('#EditTitleEn').val(data.titleEn);
                $('#EditTitleAr').val(data.titleAr);
                $('#EditDescriptionEn').val(data.descriptionEn);
                $('#EditDescriptionAr').val(data.descriptionAr);
                $('#EditFileLink').html(`<a href="${data.fileUrl}" target="_blank">Current PDF</a>`);
                $('#edit-modal').modal('show');
            }).fail(function() {
                alert("Failed to load brochure data.");
            });
        }




        // Update brochure
        $('#UpdateBrouchureBtn').click(function () {
            var formData = new FormData();
            formData.append("Id", $('#EditId').val());
            formData.append("TitleEn", $('#EditTitleEn').val());
            formData.append("TitleAr", $('#EditTitleAr').val());
            formData.append("DescriptionEn", $('#EditDescriptionEn').val());
            formData.append("DescriptionAr", $('#EditDescriptionAr').val());
            var file = $('#EditFile')[0].files[0];
            if (file) formData.append("file", file);

            $.ajax({
                url: '@Url.Action("Update", "Brouchures")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function() { location.reload(); },
                error: function(xhr) { alert("Error: " + xhr.responseText); }
            });
        });

        // Delete brochure
        var deleteId = null;
        function openDeleteModal(id) { deleteId = id; $('#delete-modal').modal('show'); }
        $('#ConfirmDeleteBtn').click(function () {
            $.post('@Url.Action("Delete", "Brouchures")', { id: deleteId }, function () {
                $('#delete-modal').modal('hide');
                $(`#brouchure-card-${deleteId}`).remove();
            }).fail(function(xhr) { alert("Error: " + xhr.responseText); });
        });

        // Download brochure
        function downloadFile(id) {
            $.ajax({
                url: `/Download/${id}`,
                method: 'GET',
                xhrFields: { responseType: 'blob' },
                success: function (data, status, xhr) {
                    var filename = "brouchure.pdf";
                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    if (disposition && disposition.indexOf('filename=') !== -1)
                        filename = disposition.split('filename=')[1].replace(/"/g, '');
                    var blob = new Blob([data], { type: 'application/pdf' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = filename;
                    link.click();
                },
                error: function () { alert("Download failed."); }
            });
        }
    </script>
}

