@model List<KHQ.Domain.ViewModel.BrouchuresVM>

<div class="content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item">>Dashboards / </li>
                            <li class="breadcrumb-item">>FAQ page / </li>
                            <li class="breadcrumb-item active">Brochures</li>
                        </ol>
                    </div>
                    <h4 class="page-title">FAQ page > Brochures</h4>
                </div>
            </div>
        </div>

        <!-- Add Button -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body d-flex justify-content-end">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#add-modal">
                            <i class="fa-regular fa-circle-plus"></i> Add New
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Brouchures List -->
        <div class="row" id="brouchures-list">
            @foreach (var item in Model)
            {
                <div class="col-xl-4" id="brouchure-card-@item.Id">
                    <div class="card product-box">
                        <div class="card-body">
                            <div class="product-action">
                                <button type="button" class="btn btn-success btn-xs waves-effect waves-light" data-bs-toggle="modal"
                                        data-bs-target="#edit-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-xs waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#danger-alert-modal-@item.Id">
                                    <i class="fa-sharp fa-light fa-trash"></i>
                                </button>
                            </div>
                            <div class="mt-3">
                                <h5>@item.FileName</h5>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <button class="btn btn-primary all-btn btn-sm" onclick="downloadFile('@item.Id')">
                                        <i class="fa-regular fa-download"></i> Download
                                    </button>
                                }
                            </div>
                            <div id="edit-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-body">
                                            <div class="alert alert-success alert-success-edit display-none">
                                                <i class="fa-sharp fa-light fa-circle-check"></i> Section edited successfully.
                                            </div>
                                            <form id="BrouchuresFormEdit" enctype="multipart/form-data">
                                                <div class="mb-3">
                                                    <label for="FileUploadEdit-@item.Id" class="form-label">Replace PDF (optional):</label>
                                                    <input class="form-control" type="file" id="FileUploadEdit-@item.Id" accept="application/pdf" />

                                                    @if (!string.IsNullOrEmpty(item.FilePath))
                                                    {
                                                        <div class="mt-2">
                                                            <span class="text-muted">Current file:</span>
                                                            <i class="fa-regular fa-file-pdf"></i> @item.FileName
                                                        </div>
                                                    }

                                                    <span class="validationFileUpload text-danger display-none">* this field is required</span>
                                                </div>
                                                <div class="mb-2 text-center">
                                                    <button class="btn btn-primary all-btn btn-submit" id="EditBrouchuresSectionsbtn-@item.Id"
                                                            type="button" onclick="saveEdit('@item.Id')">
                                                        Save
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="danger-alert-modal-@item.Id" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog modal-sm">
                                    <div class="modal-content modal-filled bg-danger">
                                        <div class="modal-body p-4">
                                            <div class="text-center">
                                                <i class="fa-regular fa-ban text-white font-36"></i>
                                                <h4 class="mt-2 text-white">Oh snap!</h4>
                                                <p class="mt-3 text-white">Are you sure you want to delete ?</p>
                                                <button type="button"
                                                        data-id="@item.Id"
                                                        class="btn btn-light my-2 deleteBrouchures"
                                                        data-bs-dismiss="modal">
                                                    Continue
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add modal content -->
<div id="add-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="alert alert-success display-none">
                    <i class="fa-sharp fa-light fa-circle-check"></i> Section added successfully.
                </div>
                <form id="BrouchuresForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="FileUpload" class="form-label">PDF File</label>
                        <input class="form-control" type="file" id="FileUpload" accept="application/pdf" />
                        <span class="validationFileUpload text-danger display-none">* this field is required</span>
                    </div>
                    <div class="mb-2 text-center">
                        <button class="btn btn-primary all-btn btn-submit" id="SaveBrouchuresSectionsbtn"
                                type="button">
                            Save
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.5.0/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#SaveBrouchuresSectionsbtn').click(function () {
        var validation = true;
        var file = $('#FileUpload')[0].files[0];

        // Validation logic  
        if (!file) {
        $(".validationFileUpload").removeClass("display-none");
            return;
        } else {
            $(".validationFileUpload").addClass("display-none");
        }

        if (validation) {
            var formData = new FormData();
            formData.append("file", file);

            $.ajax({
                url: '@Url.Action("Add", "Brouchures")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    $(".alert-success").removeClass("display-none");
                    $(".alert-success").addClass("d-flex");

                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        }
        });

        $(document).on("click", ".deleteBrouchures", function () {
            var id = $(this).data('id');
            var formData = new FormData();
            formData.append('id', id);

            $.ajax({
                url: '@Url.Action("Delete", "Brouchures")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        });
    });

    function saveEdit(itemId) {
        var validation = true;
        var file = $('#FileUploadEdit-' + itemId)[0].files[0];

        // Validation logic
        if (!file) {
        $(".validationFileUpload").removeClass("display-none");
            return;
        } else {
            $(".validationFileUpload").addClass("display-none");
        }

        if (validation) {
            var formData = new FormData();
            formData.append('id', itemId);
            formData.append('file', file);

            $.ajax({
                url: '@Url.Action("Update", "Brouchures")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    $(".alert-success-edit").removeClass("display-none");
                    $(".alert-success-edit").addClass("d-flex");

                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            });
        }
    }

    // Download brochure
    function downloadFile(id) {
        $.ajax({
            url: `/Download/${id}`,
            method: 'GET',
            xhrFields: { responseType: 'blob' },
            success: function (data, status, xhr) {
                var filename = "brouchure.pdf";
                var disposition = xhr.getResponseHeader('Content-Disposition');
                if (disposition && disposition.indexOf('filename=') !== -1)
                    filename = disposition.split('filename=')[1].replace(/"/g, '');
                var blob = new Blob([data], { type: 'application/pdf' });
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = filename;
                link.click();
            },
            error: function () { alert("Download failed."); }
        });
    }
</script>